---
import { getEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import StatusChip from '../../components/ui/StatusChip.astro';
import { products } from '../../lib/content';
const page = (await getEntry('pages', 'products'))!;
const prod = await products();
---

<Page title={page.data.seo.title} description={page.data.seo.description} heading={page.data.title} lead={page.data.lead} crumbs={[{ name: 'Products', href: '/products/' }]} pageType="CollectionPage">
  <section class="section" data-theme="paper">
    <div class="wrap">
      <ul class="list">
        {
          prod.map((p) => (
            <li>
              <a href={`/products/${p.id}/`} style={`view-transition-name: product-${p.id}`}>
                <StatusChip status={p.data.status} />
                <h2 class="t-h3">{p.data.name}</h2>
                <p class="t-muted">{p.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>

<style>
  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .list {
    display: grid;
    gap: var(--grid-gap);
  }
  @media (min-width: 64rem) {
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .list a {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    height: 100%;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .list a:hover {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
</style>
