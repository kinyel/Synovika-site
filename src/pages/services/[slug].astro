---
/**
 * A service page: the problem in the client's words, what we do, the
 * diagram, what you get, the products it relates to, questions, and the
 * other services.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/ui/Icon.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import Guides from '../../components/ui/Guides.astro';
import { products, services, type Service } from '../../lib/content';
import { shown } from '../../lib/drafts';
import { faqPage, service as serviceNode } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const all = await services();
  return all.map((s) => ({ params: { slug: s.id }, props: { s, others: all.filter((o) => o.id !== s.id) } }));
}) satisfies GetStaticPaths;
const { s, others } = Astro.props as { s: Service; others: Service[] };
const d = s.data;
const path = `/services/${s.id}/`;
const questions = d.faqs.filter(shown);
const related = (await products()).filter((p) => d.relatedProducts.includes(p.id));
const { Content } = await render(s);
const hasBody = (s.body ?? '').trim().length > 0;
const GROUP = { build: 'Build it right', run: 'Keep it running' } as const;
---

<Page
  title={d.seo.title}
  description={d.seo.description}
  heading={d.headline ?? d.name}
  lead={d.summary}
  eyebrow={`Service · ${GROUP[d.group]}`}
  icon={d.icon}
  crumbs={[
    { name: 'Services', href: '/services/' },
    { name: d.name, href: path },
  ]}
  schema={[serviceNode(path, d.name, d.seo.description), ...(questions.length ? [faqPage(path, questions)] : [])]}
>
  <div slot="hero" class="mt-8 flex flex-wrap gap-3">
    <a href={`/contact/?service=${s.id}`} class="btn btn-primary" data-magnetic>Talk to us about this <Icon name="arrow" /></a>
    <a href="/contact/?topic=call" class="btn btn-outline">Book a call <Icon name="calendar" /></a>
  </div>

  <section class="section" data-theme="paper" aria-labelledby="problem-title">
    <div class="gutter svc-grid">
      <div>
        <p class="eyebrow">Sound familiar?</p>
        <h2 id="problem-title" class="sr-only">The problem</h2>
        <blockquote class="problem" data-reveal>
          <p>{d.problem}</p>
        </blockquote>
        {
          hasBody && (
            <div class="prose mt-8">
              <Content />
            </div>
          )
        }
      </div>
      <div class="card svc-card" data-reveal>
        <h2 class="h3">What we do</h2>
        <ul class="ticks mt-5">
          {d.whatWeDo.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="how-title">
    <div class="gutter">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title" class="h2 mt-4" data-reveal>{d.name}, <span class="text-lit">in one picture</span></h2>
      <div class="mt-8" data-reveal>
        <Diagram diagram={d.diagram} title={`How ${d.name.toLowerCase()} works`} />
      </div>
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="get-title">
    <div class="gutter svc-grid">
      <div>
        <p class="eyebrow">What you get</p>
        <h2 id="get-title" class="h2 mt-4" data-reveal>Things you can <span class="text-lit">hold us to</span></h2>
      </div>
      <ul class="get-list">
        {
          d.deliverables.map((w, i) => (
            <li class="get-item" data-reveal>
              <span class="get-n">{String(i + 1).padStart(2, '0')}</span>
              {w}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" data-theme="dark" aria-labelledby="rel-title">
        <div class="gutter">
          <h2 id="rel-title" class="h3">Related products</h2>
          <ul class="tile-grid">
            {related.map((p) => (
              <li>
                <a href={`/products/${p.id}/`} class="card card-hover tile">
                  <span class={`icon-tile is-sm tint-${p.data.accent}`}>
                    <Icon name={p.data.icon} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <b>{p.data.name}</b>
                    <span>{p.data.summary}</span>
                  </span>
                  <Icon name="arrow" class="tile-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    questions.length > 0 && (
      <section class="section" data-theme="paper" aria-labelledby="sfaq-title">
        <div class="gutter svc-grid">
          <div>
            <p class="eyebrow">Questions</p>
            <h2 id="sfaq-title" class="h2 mt-4" data-reveal>
              About <span class="text-lit">{d.name.toLowerCase()}</span>
            </h2>
          </div>
          <Faq items={questions} />
        </div>
      </section>
    )
  }

  <Guides ids={d.guides} />

  <section class="section" data-theme="dark" aria-labelledby="other-title">
    <div class="gutter">
      <h2 id="other-title" class="h3">Other ways we help</h2>
      <ul class="tile-grid">
        {
          others.map((o) => (
            <li>
              <a href={`/services/${o.id}/`} class="card card-hover tile">
                <span class="icon-tile is-sm">
                  <Icon name={o.data.icon} />
                </span>
                <span class="min-w-0 flex-1">
                  <b>{o.data.name}</b>
                  <span>{o.data.blurb}</span>
                </span>
                <Icon name="arrow" class="tile-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>

<style>
  .svc-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }
  .problem {
    margin-top: 1.25rem;
    border-left: 2px solid var(--color-spark);
    padding-left: 1.4rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-white);
  }
  .svc-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .svc-card .ticks {
    font-size: 1.04rem;
    color: var(--color-grey-200);
  }
  .get-list {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
  }
  .get-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.15rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
    font-size: 1.1rem;
    color: var(--color-white);
  }
  .get-n {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 2;
    letter-spacing: 0.12em;
    color: var(--color-iris-soft);
  }
  .tile-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .tile-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tile {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
  }
  .tile b {
    display: block;
    font-size: 1.06rem;
    color: var(--color-white);
  }
  .tile span > span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.93rem;
    color: var(--color-grey-400);
  }
  .tile :global(.tile-arrow) {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--color-iris-soft);
  }
</style>
