---
import Page from '../../layouts/Page.astro';
import { getEntry } from 'astro:content';
import { services } from '../../lib/content';
const page = (await getEntry('pages', 'services'))!;
const svc = await services();
---

<Page title={page.data.seo.title} description={page.data.seo.description} heading={page.data.title} lead={page.data.lead} crumbs={[{ name: 'Services', href: '/services/' }]} pageType="CollectionPage">
  <section class="section" data-theme="dark">
    <div class="wrap">
      <ul class="list">
        {
          svc.map((s) => (
            <li>
              <a class="glass glass-hover" href={`/services/${s.id}/`}>
                <h2 class="t-h3">{s.data.name}</h2>
                <p class="t-muted">{s.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>

<style>
  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .list {
    display: grid;
    gap: var(--grid-gap);
  }
  @media (min-width: 48rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .list a {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    height: 100%;
    padding: 1.75rem;
  }
</style>
