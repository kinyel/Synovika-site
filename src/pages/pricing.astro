---
/**
 * Pricing (the reference image's nav item, made honest): how we quote, the
 * ways to work with us, what moves the price, and the products' prices,
 * which come at launch. No figures we can't stand behind.
 */
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import Icon from '../components/ui/Icon.astro';
import Faq from '../components/ui/Faq.astro';
import { faqs } from '../lib/content';
import { faqPage } from '../lib/schema';

const page = (await getEntry('pages', 'pricing'))!.data;
const questions = (await faqs()).filter((f) => ['pricing', 'timeline', 'someone-elses-code', 'after-launch'].includes(f.id)).map((f) => f.data);
const ways = [
  { icon: 'build', title: 'Projects', body: 'New software, built in stages. You get a written quote for each stage before it starts, so you always know what the next step costs.', href: '/services/software-development/' },
  { icon: 'bug', title: 'Fixes and rescues', body: "Software that's broken or that someone else built. We read the code first, tell you what we find, then quote for the fix.", href: '/services/fixing-and-debugging/' },
  { icon: 'heartbeat', title: 'Ongoing support', body: "Updates, monitoring and fixes after launch, with a short note each month on what we did. Quoted once we've seen the system.", href: '/services/maintenance-and-support/' },
  { icon: 'sparkle', title: 'Our products', body: 'Selvion, the Estate Entrance Security System and Websites with an Admin Panel are in development. Prices come at launch, and the waitlist hears first.', href: '/products/' },
] as const;
const factors = [
  { title: 'How much it does', body: 'The number of screens, features and rules the software must handle.' },
  { title: 'Who uses it', body: 'Each kind of user, from customers to managers, adds its own screens and permissions.' },
  { title: 'What it connects to', body: 'Payments, messages, existing systems and outside services each take work to connect safely.' },
  { title: 'Where you are today', body: "Starting fresh, or working with code that's already there, and the state that code is in." },
  { title: 'Design', body: 'Whether you have a design already, or need one made.' },
  { title: 'Timescale', body: 'A fixed date can mean more people working at once.' },
];
const steps = [
  { title: 'A first conversation', body: 'You tell us how your business works and what you need. We ask a lot of questions.' },
  { title: 'A short write-up', body: 'We send back what we heard, so you can check we understood.' },
  { title: 'A written quote, in stages', body: 'Each stage has its own price, what you get at the end of it, and a rough timeline.' },
  { title: 'You decide', body: 'Nothing starts until you agree. If anything changes the price later, we tell you before we do the work.' },
];
---

<Page
  title={page.seo.title}
  description={page.seo.description}
  heading={page.title}
  lead={page.lead}
  eyebrow="Pricing"
  icon="chart"
  crumbs={[{ name: 'Pricing', href: '/pricing/' }]}
  schema={questions.length ? [faqPage('/pricing/', questions)] : []}
>
  <section class="section" data-theme="paper" aria-labelledby="ways-title">
    <div class="gutter">
      <p class="eyebrow">Ways to work with us</p>
      <h2 id="ways-title" class="h2 mt-4" data-reveal>Four ways in, <span class="text-lit">one way of quoting</span></h2>
      <ul class="ways">
        {
          ways.map((w) => (
            <li data-reveal>
              <a href={w.href} class="card card-hover way">
                <span class="icon-tile">
                  <Icon name={w.icon} />
                </span>
                <h3 class="h3 mt-5">{w.title}</h3>
                <p class="mt-2 text-grey-200">{w.body}</p>
                <span class="link-arrow mt-auto pt-5">
                  Read more<span class="sr-only"> about {w.title.toLowerCase()}</span> <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="quote-title">
    <div class="gutter two">
      <div>
        <p class="eyebrow">How a quote works</p>
        <h2 id="quote-title" class="h2 mt-4" data-reveal>No surprises, <span class="text-lit">in writing</span></h2>
        <p class="lead mt-4" data-speakable data-reveal>We quote in stages, in writing, before any work starts, and we tell you before anything changes the price.</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h3">{s.title}</h3>
                <p class="mt-2 text-grey-200">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="factors-title">
    <div class="gutter">
      <p class="eyebrow">What moves the price</p>
      <h2 id="factors-title" class="h2 mt-4" data-reveal>Six things that <span class="text-lit">make the difference</span></h2>
      <ul class="factors">
        {
          factors.map((f) => (
            <li class="factor" data-reveal>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    questions.length > 0 && (
      <section class="section" data-theme="dark" aria-labelledby="pq-title">
        <div class="gutter two">
          <div>
            <p class="eyebrow">Questions</p>
            <h2 id="pq-title" class="h2 mt-4" data-reveal>
              About <span class="text-lit">price and time</span>
            </h2>
          </div>
          <Faq items={questions} />
        </div>
      </section>
    )
  }
</Page>

<style>
  .ways {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 640px) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .ways {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ways > li {
    display: flex;
  }
  .way {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 1.6rem;
  }
  .two {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .two {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: start;
    }
  }
  .steps {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
  }
  .step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
  }
  .step-n {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 2.2;
    letter-spacing: 0.12em;
    color: var(--color-spark-glow);
  }
  .factors {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin-top: 2.25rem;
  }
  @media (min-width: 768px) {
    .factors {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .factor {
    border-top: 1px solid color-mix(in srgb, var(--color-iris-soft) 30%, transparent);
    padding-top: 1rem;
  }
  .factor h3 {
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--color-white);
  }
  .factor p {
    margin-top: 0.4rem;
    color: var(--color-grey-200);
  }
</style>
