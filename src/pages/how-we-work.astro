---
/**
 * How we work: the seven stages in full. Each says what happens, what you
 * get at the end, and what we need from you. The same stages as the glass
 * plates on the home page.
 */
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import Icon from '../components/ui/Icon.astro';
import { home } from '../lib/content';

const page = (await getEntry('pages', 'how-we-work'))!.data;
const steps = (await home()).journey!.items;
---

<Page
  title={page.seo.title}
  description={page.seo.description}
  heading={page.title}
  lead={page.lead}
  eyebrow="The process"
  icon="architecture"
  crumbs={[{ name: 'How we work', href: '/how-we-work/' }]}
>
  <section class="section" data-theme="dark" aria-label="The seven stages">
    <ol class="gutter stages">
      {
        steps.map((s, i) => (
          <li class="stage-row" data-reveal>
            <div class="stage-head">
              <span class="stage-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-tile is-sm">
                <Icon name={s.icon ?? 'check'} />
              </span>
            </div>
            <div class="stage-body">
              <p class="stage-name">{s.title}</p>
              <h2 class="h3 mt-1">{s.heading}</h2>
              <p class="mt-3 text-grey-200">{s.body}</p>
              <dl class="stage-dl">
                {s.caption && (
                  <div>
                    <dt>You get</dt>
                    <dd>{s.caption}</dd>
                  </div>
                )}
                {s.need && (
                  <div>
                    <dt>We need from you</dt>
                    <dd>{s.need}</dd>
                  </div>
                )}
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Page>

<style>
  .stages {
    display: grid;
    max-width: 60rem;
  }
  .stage-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  @media (min-width: 768px) {
    .stage-row {
      gap: 2.5rem;
    }
  }
  .stage-head {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .stage-n {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    color: var(--color-iris-soft);
  }
  .stage-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-glow);
  }
  .stage-dl {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .stage-dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .stage-dl > div {
    border-radius: 0.9rem;
    padding: 0.9rem 1rem;
    background: color-mix(in srgb, var(--color-white) 3%, var(--color-night));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .stage-dl dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .stage-dl dd {
    margin-top: 0.35rem;
    font-size: 0.98rem;
    color: var(--color-white);
  }
</style>
