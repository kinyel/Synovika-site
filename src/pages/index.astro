---
/**
 * Home: the reference image's page, on raleston-web's engine (D-047).
 *   01 Hero and product tour   a night city; the camera visits each product's district
 *   03 Services                the spiral staircase
 *      Industries band         where the image has client logos (we have none yet)
 *   04 Why Synovika            the cube, four promises, and the plain facts
 *   06 What we build           the capabilities board
 *   07 How we work             seven glass plates
 *   08 Inside Selvion          the flow, from ignition to phone
 *   09 Your data, put to work  the layered model
 *   10 Industries              the ring
 *   11 From the notebook       the latest articles
 *   12 Questions
 *   13 Ready to build around reality? (the closing band, from Base)
 */
import Base from '../layouts/Base.astro';
import City from '../components/sections/City.astro';
import Services from '../components/sections/Services.astro';
import IndustriesBand from '../components/sections/IndustriesBand.astro';
import Why from '../components/sections/Why.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Journey from '../components/sections/Journey.astro';
import SelvionFlow from '../components/sections/SelvionFlow.astro';
import DataSection from '../components/sections/DataSection.astro';
import Industries from '../components/sections/Industries.astro';
import Notebook from '../components/sections/Notebook.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import { faqs, home, industries, products, services } from '../lib/content';
import { faqPage, itemList } from '../lib/schema';

const closing = (await home()).closing!;
const questions = await faqs();
const prod = await products();
const svc = await services();
const ind = await industries();
---

<Base
  title="Synovika: software engineering company in Nigeria"
  description="Nigerian software engineering company: custom software, requirements engineering, fleet and vehicle tracking, estate visitor management and business websites."
  name="Synovika"
  cta={{ title: closing.heading, lit: closing.lit, lead: closing.lead }}
  schema={[
    itemList(
      '/',
      'products',
      'Synovika products',
      prod.map((p) => ({ name: p.data.name, path: `/products/${p.id}/` })),
    ),
    itemList(
      '/',
      'services',
      'Synovika services',
      svc.map((s) => ({ name: s.data.name, path: `/services/${s.id}/` })),
    ),
    itemList(
      '/',
      'industries',
      'Industries Synovika builds for',
      ind.map((i) => ({ name: i.data.name, path: `/industries/${i.id}/` })),
    ),
    ...(questions.length ? [faqPage('/', questions.map((q) => q.data))] : []),
  ]}
>
  <City />
  <Services />
  <IndustriesBand />
  <Why />
  <Capabilities />
  <Journey />
  <SelvionFlow />
  <DataSection />
  <Industries />
  <Notebook />
  <FaqSection />
</Base>
