---
/** Insights: every article, newest first, each with its short answer. */
import { getEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Icon from '../../components/ui/Icon.astro';
import { insights } from '../../lib/content';
import { itemList } from '../../lib/schema';

const page = (await getEntry('pages', 'insights'))!.data;
const posts = await insights();
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Page
  title={page.seo.title}
  description={page.seo.description}
  heading={page.title}
  lead={page.lead}
  eyebrow="From the notebook"
  icon="book"
  pageType="CollectionPage"
  crumbs={[{ name: 'Insights', href: '/insights/' }]}
  schema={[itemList('/insights/', 'list', 'Synovika insights', posts.map((p) => ({ name: p.data.title, path: `/insights/${p.id}/` })))]}
>
  <section class="section" data-theme="dark" aria-label="Articles">
    <div class="gutter">
      {
        posts.length === 0 ? (
          <p class="lead">The first articles are on their way.</p>
        ) : (
          <ul class="posts">
            {posts.map((p) => (
              <li data-reveal>
                <a href={`/insights/${p.id}/`} class="card card-hover post">
                  <p class="post-meta">
                    <span>{p.data.tags[0] ?? 'Insights'}</span>
                    <time datetime={p.data.published.toISOString().slice(0, 10)}>{fmt(p.data.published)}</time>
                  </p>
                  <h2 class="h3 mt-3">{p.data.title}</h2>
                  <p class="mt-3 text-grey-200">{p.data.description}</p>
                  <span class="link-arrow mt-auto pt-5">
                    Read it<span class="sr-only">: {p.data.title}</span> <Icon name="arrow" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Page>

<style>
  .posts {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .posts > li {
    display: flex;
  }
  .post {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 1.7rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .post-meta time {
    color: var(--color-grey-400);
  }
</style>
