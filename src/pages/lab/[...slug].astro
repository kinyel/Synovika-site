---
/**
 * The design lab (brief section 20, Phase 1), for Hero to approve the look:
 * logo, colour with contrast, type, components in every register, chrome,
 * texture, section moods, easing, and the 3D mark with sliders and poster.
 *
 * Built only in dev and draft builds. In production getStaticPaths returns
 * nothing, so /lab/ does not exist (D-025). The poster renderer is /lab/poster/.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Logo from '../../components/brand/Logo.astro';
import markPng from '../../assets/brand/mark.png';
import '@fontsource-variable/mona-sans';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jost';
import Base from '../../layouts/Base.astro';
import StatusChip from '../../components/ui/StatusChip.astro';
import Icon from '../../components/ui/Icon.astro';
import { SHOW_DRAFTS } from '../../lib/drafts';
import { ratio } from '../../../scripts/lib/contrast.mjs';
import tokensCss from '../../styles/tokens.css?raw';

export const getStaticPaths = (() => (SHOW_DRAFTS ? [{ params: { slug: undefined } }] : [])) satisfies GetStaticPaths;

// Ramps, read from tokens.css so the lab shows exactly what the site uses.
const all = [...tokensCss.matchAll(/--color-([a-z]+)-(\d+):\s*(#[0-9a-f]{6})/gi)].map((m) => ({ ramp: m[1]!, step: m[2]!, hex: m[3]!.toLowerCase() }));
const ramps = ['teal', 'blue', 'wine', 'neutral'].map((r) => ({ name: r, steps: all.filter((c) => c.ramp === r) }));
const brandHex: Record<string, string> = { '#0d9488': 'Teal', '#2563eb': 'Blue', '#722f37': 'Wine', '#c0c0c0': 'Silver', '#808080': 'Grey', '#171717': 'Black' };

// The semantic aliases of each register, and the contrast of every text pair they make.
const block = (name: string) => tokensCss.match(new RegExp(`\\[data-theme='${name}'\\] \\{([^}]*)\\}`))![1]!;
const aliases = (name: string) => Object.fromEntries([...block(name).matchAll(/--color-([a-z-]+):\s*(#[0-9a-f]{6})/gi)].map((m) => [m[1]!, m[2]!.toLowerCase()]));
const registers = ['dark', 'black', 'teal', 'paper'].map((name) => {
  const a = aliases(name);
  const pairs = [
    ['Headings', 'ink', 'surface', 4.5],
    ['Body and lead', 'ink-soft', 'surface', 4.5],
    ['Secondary text', 'ink-muted', 'surface', 4.5],
    ['Live / verified text', 'live-ink', 'surface', 4.5],
    ['Data / link text', 'data-ink', 'surface', 4.5],
    ['Alert / denied text', 'alert-ink', 'surface', 4.5],
    ['Text on raised surface', 'ink', 'surface-raised', 4.5],
    ['Secondary on raised', 'ink-muted', 'surface-raised', 4.5],
    ['Structure lines (UI)', 'structure', 'surface', 3],
    ['Focus ring (UI)', 'focus', 'surface', 3],
  ].map(([label, fg, bg, min]) => {
    const r = ratio(a[fg as string]!, a[bg as string]!);
    return { label: label as string, fg: a[fg as string]!, bg: a[bg as string]!, r: r.toFixed(2), ok: r >= (min as number), min };
  });
  return { name, a, pairs };
});
const button = `${ratio('#ffffff', '#0f766e').toFixed(2)}:1 at the teal end and ${ratio('#ffffff', '#1d4ed8').toFixed(2)}:1 at the blue end`;

const eases = [
  { name: 'ease-out', css: 'var(--ease-out)', note: 'Entrances, reveals, most motion' },
  { name: 'ease-in-out', css: 'var(--ease-in-out)', note: 'Things that travel between two places' },
  { name: 'ease-spring', css: 'var(--ease-spring)', note: 'Magnetic buttons, small settles' },
];
const durations = ['dur-1', 'dur-2', 'dur-3', 'dur-4'];
const typefaces = [
  { name: 'Urbanist + Geist Mono (default)', display: 'var(--font-urbanist)', text: 'var(--font-urbanist)', mono: 'var(--font-geist-mono)' },
  { name: 'Mona Sans', display: "'Mona Sans Variable', sans-serif", text: "'Mona Sans Variable', sans-serif", mono: 'var(--font-geist-mono)' },
  { name: 'Unbounded + Instrument Sans', display: "'Unbounded Variable', sans-serif", text: "'Instrument Sans Variable', sans-serif", mono: 'var(--font-geist-mono)' },
  { name: 'Jost', display: "'Jost Variable', sans-serif", text: "'Jost Variable', sans-serif", mono: 'var(--font-geist-mono)' },
];
---

<Base title="Design lab | Synovika" description="The Synovika design lab: logo, colour, type, components, materials, motion and the 3D mark, for review before any of it is used on the site." noindex>
      <section class="lab-hero noise" data-theme="dark">
        <div class="atmos" aria-hidden="true"></div>
        <div class="wrap">
          <p class="pill"><span class="signal" aria-hidden="true"></span>Phase 1 · For Hero's approval</p>
          <h1 class="t-display">
            Design <span class="chrome">lab.</span>
          </h1>
          <p class="t-lead">Everything the site is built from, on one page. Approve it here and it's used everywhere. This page exists only in draft builds.</p>
          <nav class="lab-toc" aria-label="Lab sections">
            {[
              ['Logo', 'logo'],
              ['Colour', 'colour'],
              ['Type', 'type'],
              ['Components', 'components'],
              ['Chrome', 'chrome'],
              ['Texture', 'texture'],
              ['Moods', 'moods'],
              ['Motion', 'motion'],
              ['Glass', 'glass'],
              ['3D language', 'language'],
              ['3D mark', 'mark-3d'],
            ].map(([label, id]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
        </div>
      </section>

      {/* ── Logo ─────────────────────────────────────────── */}
      <section class="lab noise" id="logo" data-theme="dark">
        <div class="atmos" aria-hidden="true"></div>
        <div class="wrap">
          <h2 class="t-h2">
            Your <span class="text-lit">logo</span>, as you made it.
          </h2>
          <p class="t-lead">Every logo on the site is your file, only cropped and resized (D-044). The header uses the crop without the tagline line, which is unreadable that small.</p>
          <div class="lockups">
            <figure class="lockup glass">
              <Logo height={150} tagline />
              <figcaption class="t-label t-muted">Full lockup, with the tagline</figcaption>
            </figure>
            <figure class="lockup glass">
              <Logo height={150} />
              <figcaption class="t-label t-muted">Header and footer: without the tagline line</figcaption>
            </figure>
            <figure class="lockup glass">
              <Image src={markPng} alt="The Synovika mark" width={220} class="mark-img" />
              <figcaption class="t-label t-muted">The mark alone: app icons and favicons</figcaption>
            </figure>
            <figure class="lockup paper-tile">
              <Logo height={110} tagline />
              <figcaption class="t-label">On white, as it was made</figcaption>
            </figure>
          </div>
          <h3 class="t-h3 sub">Icons</h3>
          <p class="t-muted">Your mark, scaled down. At 16 px it loses detail; that is accepted rather than redrawing it.</p>
          <div class="icons">
            {[16, 32].map((s) => (
              <figure>
                <img src="/favicon.ico" alt="" width={s} height={s} />
                <figcaption class="t-label t-muted">{s}px</figcaption>
              </figure>
            ))}
            <figure>
              <img src="/apple-touch-icon.png" alt="" width="90" height="90" />
              <figcaption class="t-label t-muted">App icon</figcaption>
            </figure>
            <figure>
              <img src="/logo-512.png" alt="" width="90" height="90" />
              <figcaption class="t-label t-muted">Search and social</figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* ── Colour ───────────────────────────────────────── */}
      <section class="lab" id="colour" data-theme="dark">
        <div class="wrap">
          <h2 class="t-h2">Colour</h2>
          <p class="t-lead">Your seven brand colours inside four ramps, plus the teal-black night (#031514) the site stands on. Tailwind's own palette is switched off, so nothing else exists.</p>
          {ramps.map((r) => (
            <div class="ramp">
              <h3 class="t-label t-muted">{r.name}</h3>
              <ul>
                {r.steps.map((c) => (
                  <li style={`--c:${c.hex}`}>
                    <span class="swatch" />
                    <span class="t-mono">{c.step}</span>
                    <span class="t-mono t-muted">{c.hex}</span>
                    {brandHex[c.hex] && <span class="brand-tag">{brandHex[c.hex]}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <h3 class="t-h3 sub">Every text pair, by register</h3>
          <p class="t-muted">
            Measured from tokens.css at build time. The primary button is white on teal-700 into blue-700: {button}.
          </p>
          <div class="registers">
            {registers.map((reg) => (
              <div class="register" data-theme={reg.name}>
                <h4 class="t-label">{reg.name}</h4>
                <table>
                  <tbody>
                    {reg.pairs.map((p) => (
                      <tr>
                        <td>
                          <span class="pair-sample" style={`color:${p.fg};background:${p.bg}`}>Aa</span>
                        </td>
                        <td>{p.label}</td>
                        <td class="t-mono">{p.r}</td>
                        <td class="t-mono">{p.ok ? 'Pass' : 'FAIL'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── Type ─────────────────────────────────────────── */}
      <section class="lab noise" id="type" data-theme="dark">
        <div class="atmos" aria-hidden="true" style="--glow-x:90%;--glow-y:10%"></div>
        <div class="wrap">
          <h2 class="t-h2">Type</h2>
          <p class="t-lead">Urbanist with Geist Mono is the default. Its single-storey "a" and round "o" match the wordmark. The three alternatives are set the same way, next to the wordmark.</p>
          {typefaces.map((t) => (
            <article class="specimen" style={`--d:${t.display};--x:${t.text};--m:${t.mono}`}>
              <div class="specimen-head">
                <Logo height={40} class="specimen-word" />
                <p class="t-label t-muted">{t.name}</p>
              </div>
              <p class="spec-label">Selvion fleet tracking · 01 / 05</p>
              <p class="spec-display">
                Software built around <span class="chrome">reality.</span>
              </p>
              <p class="spec-h2">Know where every vehicle is, and what it's doing.</p>
              <p class="spec-body">
                We build, fix, test and maintain software for Nigerian businesses. Body text is 17 px on phones and 18 px on desktop, at weight 450 on dark, line height 1.6 and about 65 characters a line.
              </p>
              <p class="spec-mono">UNIT 07 · IGNITION ON · 06:42 · GATE CODE 482 913</p>
            </article>
          ))}
        </div>
      </section>

      {/* ── Components ───────────────────────────────────── */}
      <section class="lab" id="components" data-theme="dark">
        <div class="wrap">
          <h2 class="t-h2">Components</h2>
          <p class="t-lead">Buttons, links, chips and form fields in all three registers. Tab through them to see the focus rings.</p>
        </div>
        {['dark', 'teal', 'paper'].map((reg) => (
          <div class="components" data-theme={reg}>
            <div class="wrap">
              <p class="t-label t-muted">{reg}</p>
              <div class="row">
                <a class="btn btn-primary" href="#components">
                  <span class="signal" aria-hidden="true" />
                  Start a project
                </a>
                <a class="btn btn-secondary" href="#components">
                  See our products
                </a>
                <a class="btn btn-quiet" href="#components">
                  <Icon name="chat" />
                  <span>WhatsApp us</span>
                </a>
              </div>
              <div class="row">
                <p>
                  A sentence with <a class="link" href="#components">a link in it</a>, and the <span class="t-label t-eyebrow">eyebrow</span> style.
                </p>
              </div>
              <div class="row">
                <StatusChip status="in-development" />
                <StatusChip status="pilot" />
                <StatusChip status="live" />
                <span class="to-confirm">TO CONFIRM</span>
                <span class="todo">TODO(hero): example</span>
              </div>
              <div class="form">
                <div class="field">
                  <label class="field-label" for={`name-${reg}`}>Your name</label>
                  <input class="input" id={`name-${reg}`} autocomplete="name" />
                </div>
                <div class="field">
                  <label class="field-label" for={`email-${reg}`}>Email</label>
                  <input class="input" id={`email-${reg}`} type="email" aria-invalid="true" aria-describedby={`email-${reg}-error`} value="hero@" />
                  <p class="field-error" id={`email-${reg}-error`}>Check your email address: it should look like name@company.com.</p>
                </div>
                <div class="field">
                  <label class="field-label" for={`need-${reg}`}>What do you need?</label>
                  <select class="input" id={`need-${reg}`}>
                    <option>Software development</option>
                    <option>Join the Selvion waitlist</option>
                  </select>
                </div>
                <div class="field">
                  <label class="field-label" for={`msg-${reg}`}>Message</label>
                  <textarea class="input" id={`msg-${reg}`} rows="3" />
                  <p class="field-hint">A few lines is plenty.</p>
                </div>
                <label class="check">
                  <input type="checkbox" />
                  <span>I agree that my message is processed by our email provider outside Nigeria so that we can reply.</span>
                </label>
              </div>
            </div>
          </div>
        ))}
      </section>

      {/* ── Glass and light ──────────────────────────────── */}
      <section class="lab noise" id="glass" data-theme="dark">
        <div class="atmos" aria-hidden="true" style="--glow-x:20%;--glow-y:30%;--glow2-x:90%;--glow2-y:80%"></div>
        <div class="wrap">
          <h2 class="t-h2">
            Glass and <span class="text-lit">light</span>.
          </h2>
          <p class="t-lead">synov-timer's colouring, in teal (D-045): a teal-black night, big soft teal and blue glows, a drafting grid that fades out, glass with lit edges, and glowing teal emphasis.</p>
          <div class="row">
            <p class="pill"><span class="signal" aria-hidden="true"></span>Software engineering · Products · Nigeria</p>
            <p class="eyebrow">Eyebrow with a double rule</p>
          </div>
          <div class="row">
            <span class="badge badge-live">Live</span>
            <span class="badge badge-data">Data</span>
            <span class="badge badge-alert">Alert</span>
          </div>
          <div class="glass-grid">
            <a class="glass glass-hover glass-demo" href="#glass">
              <span class="icon-tile"><Icon name="check" /></span>
              <span class="t-h3">A glass card</span>
              <span class="t-muted">Hover it: the edge lights teal and it lifts a little.</span>
            </a>
            <div class="glass glass-demo">
              <span class="t-label t-eyebrow">Up to</span>
              <span class="t-h2">06:42</span>
              <span class="t-muted">A glass readout, for telemetry and numbers.</span>
            </div>
            <div class="glass glass-demo">
              <p class="t-h3">Software built <span class="text-lit">around reality</span>.</p>
              <span class="t-muted">Lit emphasis: one phrase per headline.</span>
            </div>
          </div>
        </div>
      </section>

      {/* ── 3D language ──────────────────────────────────── */}
      <section class="lab noise" id="language" data-theme="dark">
        <div class="atmos" aria-hidden="true" style="--glow-x:70%;--glow-y:40%;--grid-x:66%;--grid-y:55%"></div>
        <div class="wrap">
          <h2 class="t-h2">
            The <span class="text-lit">3D language</span>.
          </h2>
          <p class="t-lead">synov-timer's glass primitives, in teal (D-046): glass blocks on a glass board, lines of light, and glass plates. Move your pointer over them. The product stories are built from these.</p>
          <div class="models">
            <figure class="model">
              <div class="s3d model-stage" data-s3d style="--k:1;--rx:58deg;--rz:42deg">
                <div class="s3d-world">
                  <span class="board" style="--w:320px;--cell:40px"></span>
                  <span class="blk" style="--w:60px;--h:30px;--x:-100px;--y:-90px"><b class="blk-top"><span class="blk-label">Depot A</span></b><b class="blk-e"></b><b class="blk-s"></b></span>
                  <span class="blk" style="--w:50px;--h:46px;--x:20px;--y:-100px"><b class="blk-top"></b><b class="blk-e"></b><b class="blk-s"></b></span>
                  <span class="blk" style="--w:70px;--h:22px;--x:100px;--y:40px"><b class="blk-top"></b><b class="blk-e"></b><b class="blk-s"></b></span>
                  <span class="blk is-lit" style="--w:44px;--h:14px;--x:-20px;--y:70px;--dz:calc((1 - var(--p)) * 60px)"><b class="blk-top"><span class="blk-label">Unit 07</span></b><b class="blk-e"></b><b class="blk-s"></b></span>
                  <span class="s3d-line" style="--x1:-100px;--y1:-60px;--len:130px;--ang:90deg;--draw:var(--p)"></span>
                  <span class="s3d-line" style="--x1:-100px;--y1:70px;--len:80px;--ang:0deg;--draw:var(--p)"></span>
                </div>
              </div>
              <figcaption class="t-label t-muted">Glass blocks, a board and a route of light (Selvion's map)</figcaption>
            </figure>
            <figure class="model">
              <div class="s3d model-stage" data-s3d style="--k:1;--rx:56deg;--rz:-40deg">
                <div class="s3d-world">
                  {[0, 1, 2].map((i) => (
                    <span class={`plate${i === 1 ? ' is-lit' : ''}`} style={`--size:190px;--pz:${(1 - i) * 70}px`}>
                      <span class="plate-edge" style="--e:3" />
                      <span class="plate-edge" style="--e:2" />
                      <span class="plate-edge" style="--e:1" />
                      <span class="plate-face">
                        <span class="plate-label">{['Created', 'Verified', 'Logged'][i]}</span>
                      </span>
                    </span>
                  ))}
                </div>
              </div>
              <figcaption class="t-label t-muted">Glass plates, one lit (the estate code's journey)</figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* ── Chrome ───────────────────────────────────────── */}
      <section class="lab noise" id="chrome" data-theme="dark">
        <div class="atmos" aria-hidden="true" style="--glow-x:60%;--glow-y:50%"></div>
        <div class="wrap">
          <h2 class="t-h2">Chrome</h2>
          <p class="t-lead">White through silver to steel, for one word per headline and for 1 px borders on dark. The highlight follows scroll; drag the slider to see it move.</p>
          <p class="t-display chrome-demo" data-chrome-demo>
            Built around <span class="chrome">reality.</span>
          </p>
          <label class="slider">
            <span class="t-label t-muted">Highlight (--p)</span>
            <input type="range" min="0" max="1" step="0.01" value="0.35" data-chrome-slider />
          </label>
          <div class="chrome-border chrome-card">
            <p class="t-label t-muted">Chrome border</p>
            <p>A 1 px chrome hairline around a card on dark.</p>
          </div>
        </div>
      </section>

      {/* ── Texture ──────────────────────────────────────── */}
      <section class="lab" id="texture" data-theme="dark">
        <div class="wrap">
          <h2 class="t-h2">Texture</h2>
          <p class="t-lead">A static noise layer at 2.5% over dark gradients, so they don't band. The vignette is for the hero only.</p>
          <div class="textures">
            <div class="tex">
              <span class="t-label">Gradient, no noise</span>
            </div>
            <div class="tex noise">
              <span class="t-label">Gradient with noise</span>
            </div>
            <div class="tex noise vignette">
              <span class="t-label">Noise and vignette (hero)</span>
            </div>
          </div>
        </div>
      </section>

      {/* ── Section moods ────────────────────────────────── */}
      <section class="lab" id="moods" data-theme="dark">
        <div class="wrap">
          <h2 class="t-h2">Section moods</h2>
          <p class="t-lead">Colour as architecture. The page changes register on purpose, and the header follows whichever section is under it.</p>
          <ul class="moods">
            {[
              ['Hero', 'dark', 'Teal night, the chrome and teal mark on a glowing grid floor'],
              ['Statement', 'dark', 'Night, a giant outlined REALITY'],
              ['Selvion story', 'dark', 'A night map on a glass board: teal route, blue water, wine alerts'],
              ['Estate story', 'dark', 'A night gate on glass: teal for verified, wine for denied'],
              ['Website demo', 'dark', 'Night, with the example site on white inside a frame'],
              ['Services, FAQ', 'dark', 'Glass cards and glass rows in the night'],
              ['How we work', 'dark', 'A stair of glass cards around a beam of light'],
              ['Principles', 'teal', 'Teal flood, white text'],
              ['Closing CTA', 'dark', 'Night, the mark returns'],
              ['Footer', 'black', 'Your brand black'],
            ].map(([name, reg, note]) => (
              <li class="mood" data-theme={reg}>
                {reg === 'dark' && <span class="atmos" aria-hidden="true" />}
                <span class="t-h3">{name}</span>
                <span class="t-muted">{note}</span>
                {name === 'Statement' && (
                  <span class="t-giant mood-giant" aria-hidden="true">
                    REALITY
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* ── Motion ───────────────────────────────────────── */}
      <section class="lab" id="motion" data-theme="dark">
        <div class="wrap">
          <h2 class="t-h2">Motion</h2>
          <p class="t-lead">Three eases and four durations, used everywhere. Press play to compare them. Nothing here moves on its own.</p>
          <button class="btn btn-secondary" type="button" data-ease-play>
            Play
          </button>
          <div class="eases" data-eases>
            {eases.map((e) =>
              durations.map((d) => (
                <div class="ease" style={`--ease:${e.css};--dur:var(--${d})`}>
                  <span class="t-label t-muted">
                    {e.name} · {d.replace('dur-', '')}: <span data-dur={d} />
                  </span>
                  <span class="track">
                    <span class="signal" />
                  </span>
                </div>
              )),
            )}
          </div>
          <ul class="ease-notes">
            {eases.map((e) => (
              <li>
                <span class="t-mono">{e.name}</span> <span class="t-muted">{e.note}</span>
              </li>
            ))}
          </ul>
          <label class="check cursor-toggle">
            <input type="checkbox" data-cursor-toggle />
            <span>Try the custom cursor (off by default; it stays off unless you like it)</span>
          </label>
        </div>
      </section>

      {/* ── 3D mark ──────────────────────────────────────── */}
      <section class="lab noise" id="mark-3d" data-theme="dark">
        <div class="atmos" aria-hidden="true" style="--glow-x:30%;--glow-y:60%;--grid-x:30%;--grid-y:60%"></div>
        <div class="wrap">
          <h2 class="t-h2">3D mark</h2>
          <p class="t-lead">The one WebGL object on the site, built from the traced paths. Tune it with the sliders; the poster beside it is rendered from the same scene and camera.</p>
          <div class="mark-grid">
            <div class="stage" data-stage>
              <canvas aria-hidden="true" data-mark-canvas />
              <p class="t-label t-muted stage-note" data-stage-note>
                Loading the 3D mark…
              </p>
            </div>
            <figure class="poster">
              <img src="/poster/mark-lab.avif" alt="The pre-rendered poster of the mark" width="800" height="600" data-poster onerror="this.closest('figure').hidden=true" />
