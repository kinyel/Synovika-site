---
/**
 * Inner pages: Base plus a page hero (breadcrumbs, H1, its plain lead and a
 * small 3D plate stack). The body of the page goes in the default slot, the
 * hero's extras (buttons, dates) in the "hero" slot.
 */
import Base, { type Crumb } from './Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import type { IconName } from '../components/ui/icons';
import type { Thing } from 'schema-dts';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Words of the heading lit in teal. */
  lit?: string;
  lead: string;
  eyebrow?: string;
  crumbs?: Crumb[];
  schema?: Exclude<Thing, string>[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  /** The icon on the hero's plate stack; false for none. */
  icon?: IconName | false;
  noindex?: boolean;
  cta?: boolean | { title?: string; lit?: string; lead?: string; primary?: { label: string; href: string } };
  ogType?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** A smaller title, for long ones (articles). */
  compact?: boolean;
  /** The product this page is about (Base). */
  accent?: 'teal' | 'blue' | 'wine' | 'amber';
}
const { heading, lit, lead, eyebrow, crumbs = [], icon, compact, ...rest } = Astro.props;
---

<Base {...rest} crumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow={eyebrow} title={heading} lit={lit} lead={lead} icon={icon} compact={compact}>
    <slot name="hero" />
  </PageHero>
  <div class="is-page">
    <slot />
  </div>
</Base>
