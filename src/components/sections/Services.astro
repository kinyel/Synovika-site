---
/**
 * 03 · Services: a helix of square glass cards around one thin spine of
 * light, built to feel like primetrack.rw's spiral (D-057, D-060), in
 * Synovika's teal. Six cards, 60° apart and a step higher each. The helix
 * turns and climbs in step with the scroll, at a steady rate
 * (src/scripts/scroll.ts); two cards show at a time, the one at the front and
 * the next one up. Beside it, a rolling counter, a progress rail and the list
 * of services. Pure CSS 3D, so the text stays crisp. Without JavaScript or
 * with reduced motion, it is a grid of cards.
 *
 * The spine is the hero's DNA, in points, carried on here on its own canvas
 * and locked to the turn of the cards (src/scripts/hero.ts, D-064). This
 * section fades up over the end of the hero, so it starts while the hero is
 * still pinned: the two overlap, and for the first stretch (--hold) both are
 * pinned and nothing moves.
 */
import Icon from '../ui/Icon.astro';
import Lit from '../ui/Lit.astro';
import { home, services as allServices } from '../../lib/content';

const head = (await home()).services!;
const services = await allServices();
const N = services.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const GROUP = { build: 'Build it right', run: 'Keep it running' } as const;
---

<section id="services" class="spiral" data-theme="dark" style={`--n:${N}`} data-stair-section aria-labelledby="services-title">
  <div class="spiral-viewport" data-stair-view>
    <div class="gutter spiral-layout">
      <div class="spiral-menu">
        <p class="eyebrow">{head.eyebrow}</p>
        <h2 id="services-title" class="spiral-title"><Lit text={head.heading} lit={head.lit} /></h2>
        <p class="spiral-counter" aria-hidden="true">
          <span class="spiral-counter-slot"><span class="spiral-counter-roll" data-stair-count>{services.map((_, i) => <span>{pad(i)}</span>)}</span></span>
          <span class="spiral-counter-total">/ {String(N).padStart(2, '0')}</span>
          <span class="spiral-counter-rail"><i data-stair-rail></i></span>
        </p>
        <p class="spiral-menu-title">What do you need?</p>
        <ol class="spiral-list">
          {
            services.map((s, i) => (
              <li>
                <button type="button" class="spiral-link" data-stair-link={i}>
                  <span class="spiral-link-n">{pad(i)}</span>
                  <span class="spiral-link-name">{s.data.name}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <a href="/services/" class="link-arrow spiral-all">All services <Icon name="arrow" /></a>
      </div>

      <div class="spiral-stage" data-stair-stage>
        <div class="spiral-spine" aria-hidden="true">
          <span class="spiral-spine-line"></span>
          <span class="spiral-glow"></span>
        </div>
        <canvas class="spiral-dna" data-stair-dna aria-hidden="true"></canvas>
        <div class="spiral-ring" data-stair-ring>
          {
            services.map((s, i) => (
              <article class="spiral-item" style={`--i:${i}`} data-stair-card={i} aria-labelledby={`service-${s.id}`}>
                <div class="spiral-card">
                  <p class="spiral-card-top">
                    <span class="spiral-card-icon" aria-hidden="true">
                      <Icon name={s.data.icon} />
                    </span>
                    <span class="spiral-card-group">{GROUP[s.data.group]}</span>
                  </p>
                  <h3 id={`service-${s.id}`} class="spiral-card-label">
                    {s.data.name}
                  </h3>
                  <p class="spiral-card-desc">{s.data.blurb}.</p>
                  <a href={`/services/${s.id}/`} class="spiral-card-more">
                    More<span class="sr-only"> on {s.data.name.toLowerCase()}</span> <Icon name="arrow" />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * One turn of the helix: six square cards, 60° apart, a step higher each.
   * primetrack.rw's proportions: a 264 px card on a 240 px radius, 144 px per
   * step, under a 1320 px perspective; on phones a 200 px card, 144 px radius,
   * 84 px per step and a 720 px perspective. The scroll lengths match theirs too.
   */
  .spiral {
    --R: 240px;
    --rise: 144px;
    /* The cards are squares: one size for width and height. */
    --card: 264px;
    --persp: 1320px;
    --hold: 0svh;
    position: relative;
    height: calc(320svh + var(--hold));
  }
  :global(html.js:not(.reduced-motion)) .spiral {
    --hold: 30svh;
    z-index: 2;
    margin-top: calc(-100svh - var(--hold));
    scroll-margin-top: calc(var(--hold) * -1);
    /* It starts under the last product, so only its stage takes clicks, once it has arrived (hero.ts). */
    pointer-events: none;
  }
  :global(html.js:not(.reduced-motion)) .spiral-viewport {
    pointer-events: auto;
  }
  @media (max-width: 1023px) {
    .spiral {
      --R: 144px;
      --rise: 84px;
      --card: 200px;
      --persp: 720px;
      height: calc(250svh + var(--hold));
    }
  }
  .spiral-viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    color: var(--color-white);
    /* The hero's lines, in the same place, so they carry straight on from it. */
    --rings: 120vw 18.4vw;
    background:
      repeating-radial-gradient(var(--rings) at 78% 8%, var(--lines) 0 1px, transparent 1px 34px),
      radial-gradient(48% 46% at 66% 54%, color-mix(in srgb, var(--color-iris) 15%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-night) 0, var(--color-night) 90px, color-mix(in srgb, var(--color-navy) 55%, var(--color-night)) 100%);
  }
  @media (max-width: 1023px) {
    .spiral-viewport {
      --rings: 120vw 58vw;
    }
  }
  .spiral-layout {
    display: grid;
    height: 100%;
  }
  @media (min-width: 1024px) {
    .spiral-layout {
      grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr);
      column-gap: 1.5rem;
      align-items: center;
      padding-top: 5.5rem;
    }
    .spiral-menu {
      position: relative;
      z-index: 2;
    }
  }
  @media (max-width: 1023px) {
    .spiral-layout {
      grid-template-rows: auto minmax(0, 1fr);
      align-items: start;
      padding-top: calc(max(0.85rem, env(safe-area-inset-top)) + 5.25rem);
    }
  }

  /* ── The menu ── */
  .spiral-title {
    margin-top: 0.9rem;
    font-size: clamp(1.65rem, 3.2vw, 2.9rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .spiral-counter {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }
  /* The number rolls like an odometer. */
  .spiral-counter-slot {
    display: block;
    height: 1.25em;
    overflow: hidden;
    color: var(--color-iris-soft);
  }
  .spiral-counter-roll {
    display: grid;
    line-height: 1.25em;
    transition: transform 0.6s var(--ease-expo);
  }
  .spiral-counter-total {
    color: var(--color-grey-400);
  }
  .spiral-counter-rail {
    position: relative;
    flex: 1;
    max-width: 12rem;
    height: 1px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-white) 12%, transparent);
  }
  .spiral-counter-rail > i {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--color-iris-soft), var(--color-spark));
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-iris) 80%, transparent);
  }
  .spiral-menu-title {
    margin-top: 1.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-grey-400);
  }
  .spiral-list {
    display: grid;
    margin-top: 0.6rem;
  }
  .spiral-link {
    display: flex;
    min-height: 44px;
    width: 100%;
    align-items: baseline;
    gap: 0.9rem;
    padding-block: 0.3rem;
    text-align: left;
    cursor: pointer;
  }
  .spiral-link-n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-grey-400);
    transition: color 0.5s;
  }
  .spiral-link-name {
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    font-weight: 500;
    color: color-mix(in srgb, var(--color-grey-400) 85%, transparent);
    transition: color 0.5s;
  }
  .spiral-link:hover .spiral-link-name {
    color: var(--color-grey-200);
  }
  .spiral-link[aria-current='true'] .spiral-link-n {
    color: var(--color-iris-soft);
  }
  .spiral-link[aria-current='true'] .spiral-link-name {
    color: var(--color-white);
  }
  .spiral-all {
    margin-top: 1.25rem;
  }
  /* The counter is for phones, where the list doesn't fit. */
  @media (min-width: 1024px) {
    .spiral-counter {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    .spiral-menu-title,
    .spiral-list,
    .spiral-all {
      display: none;
    }
  }

  /* ── The helix ── */
  /* The stage keeps the helix to itself: turning cards fade at its edges, never over the menu. */
  .spiral-stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    perspective: var(--persp);
    perspective-origin: 50% 38%;
  }
  /* Desktop: soft edges, so a card turning away fades out before it reaches the menu. */
  @media (min-width: 1024px) {
    .spiral-stage {
      mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent), linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent);
      mask-composite: intersect;
    }
  }
  @media (max-width: 1023px) {
    .spiral-stage {
      overflow: visible;
      perspective-origin: 50% 42%;
    }
  }
  @media (min-width: 1024px) {
    .spiral-stage {
      height: 92%;
    }
  }
  .spiral-spine {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    pointer-events: none;
  }
  .spiral-spine-line {
    position: absolute;
    left: -0.5px;
    top: 4%;
    bottom: 4%;
    width: 1px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--color-iris-soft) 50%, transparent) 22%, color-mix(in srgb, var(--color-iris-soft) 50%, transparent) 78%, transparent);
  }
  /* The thin line is the fallback; the DNA replaces it once it's ready. */
  :global(.spiral.has-dna) .spiral-spine-line {
    display: none;
  }
  .spiral-dna {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  :global(html.js:not(.reduced-motion)) .spiral-dna {
    display: block;
  }
  .spiral-glow {
    position: absolute;
    left: -210px;
    top: 50%;
    width: 420px;
    height: 420px;
    margin-top: -210px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-teal-400) 18%, transparent), transparent 64%);
    filter: blur(10px);
  }
  .spiral-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* A card, turned to its place on the helix and pushed out to the radius. It turns
     about the spine (the ring's origin), not its own centre, or the front card would
     drift sideways a little more at every step. */
  .spiral-item {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--card);
    transform-origin: 0 0;
    transform: rotateY(calc(var(--i) * 60deg)) translate3d(calc(var(--card) / -2), calc(var(--card) / -2 - var(--i) * var(--rise)), var(--R));
    backface-visibility: hidden;
  }
  .spiral-card {
    /* --g: how lit the card is, 0 (round the back) to 1 (at the front). scroll.ts sets it. */
    --g: 1;
    display: flex;
    aspect-ratio: 1;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: 18px;
    padding: 24px;
    background: linear-gradient(158deg, #0b1816 0%, #07110f 56%, #040908 100%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) calc(9% + var(--g) * 75%), transparent),
      0 1px 2px rgb(0 0 0 / 0.4),
      0 26px 60px -26px rgb(0 0 0 / 0.85),
      0 18px 60px -30px color-mix(in srgb, var(--color-teal-400) calc(var(--g) * 60%), transparent);
  }
  .spiral-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .spiral-card-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 999px;
    color: var(--color-iris-soft);
    background: color-mix(in srgb, var(--color-iris) calc(5% + var(--g) * 14%), transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) calc(10% + var(--g) * 30%), transparent);
  }
  .spiral-card-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .spiral-card-group {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-grey-400);
  }
  .spiral-card-label {
    margin-top: 0.4rem;
    font-size: 1.19rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-white);
  }
  .spiral-card-desc {
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .spiral-card-more {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    width: fit-content;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-iris-soft);
  }
  .spiral-card-more :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.4s var(--ease-expo);
  }
  .spiral-card-more:hover :global(svg) {
    transform: translateX(4px);
  }
  @media (max-width: 1023px) {
    .spiral-card {
      padding: 16px;
      gap: 0.3rem;
    }
    .spiral-card-icon {
      width: 34px;
      height: 34px;
    }
    .spiral-card-icon :global(svg) {
      width: 17px;
      height: 17px;
    }
    .spiral-card-label {
      margin-top: 0.2rem;
      font-size: 1.02rem;
      line-height: 1.15;
    }
    /* Still a comfortable target (WCAG 2.5.8 asks for 24 px). */
    .spiral-card-more {
      min-height: 32px;
    }
    .spiral-card-desc {
      font-size: 0.8rem;
    }
    /* No room for the group's name on a phone's small square. */
    .spiral-card-group {
      display: none;
    }
  }

  /* ── Without JavaScript, or with reduced motion: the menu, then a grid of cards ── */
  :global(html:is(.reduced-motion, :not(.js))) .spiral {
    height: auto;
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-viewport {
    position: static;
    height: auto;
    overflow: visible;
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-layout {
    display: block;
    padding-top: 0;
  }
  :global(html:is(.reduced-motion, :not(.js))) :is(.spiral-counter, .spiral-menu-title, .spiral-list, .spiral-spine) {
    display: none;
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-stage {
    height: auto;
    perspective: none;
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-ring {
    position: static;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
    transform: none !important;
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-item {
    position: static;
    width: auto;
    transform: none;
    backface-visibility: visible;
  }
  :global(html:is(.reduced-motion, :not(.js))) .spiral-card {
    opacity: 1 !important;
    filter: none !important;
  }
</style>
