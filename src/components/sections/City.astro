    padding: 12px 14px 13px;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-white);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--color-iris-soft) 16%, transparent), color-mix(in srgb, var(--color-iris) 5%, transparent)),
