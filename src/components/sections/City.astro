---
/**
 * 01 · Hero and the product tour: "reality, in miniature" (D-056).
 *
 * A small isometric city at night, built from raleston-web's CSS 3D blocks:
 * a depot with its geofence, a gated estate, a high street, towers, and
 * traffic on the ring road. It is the real world our software is built
 * around. One pinned stage, driven by scroll (src/scripts/city.ts):
 *   screen one   the headline, and the city on the right, turning slowly,
 *                with a scan line sweeping its streets
 *   products     the camera flies to each district in turn and the software
 *                acts on it: Unit 07 leaves the depot and the geofence alert
 *                rises (Selvion); a visitor's code is checked and the barrier
 *                lifts (Estate Entrance Security System); the bakery's
 *                opening hours change on its website (Websites with an Admin
 *                Panel). Each product's note carries the words.
 *   closing      the camera pulls back and the city's lights dim as the
 *                services come up
 * Every scene is decorative (aria-hidden) and uses made-up demo data.
 * Without JavaScript, or with reduced motion, the city stands still beside
 * the headline and the products are a list.
 */
import Icon from '../ui/Icon.astro';
import Lit from '../ui/Lit.astro';
import markPng from '../../assets/brand/mark.png';
import { Image } from 'astro:assets';
import { SITE } from '../../data/site';
import { ctaOf, featuresOf, home, products } from '../../lib/content';

const h = (await home()).hero!;
const prod = await products();
const total = String(prod.length).padStart(2, '0');
const tour = (await home()).products!;

/** A block with a w × d footprint and a height, standing at (x, y), lifted by z (px, on the ground). */
const cb = (x: number, y: number, w: number, d: number, hgt: number, z = 0, extra = '') => `--x:${x}px;--y:${y}px;--w:${w}px;--d:${d}px;--h:${hgt}px;--z:${z}px;${extra}`;
type Block = { x: number; y: number; w: number; d: number; h: number };

// The back quarter: towers. The tallest is ours, with the Synovika mark on its roof.
const towers: Block[] = [
  { x: -268, y: -128, w: 58, d: 52, h: 128 },
  { x: -128, y: -272, w: 60, d: 58, h: 156 },
  { x: -278, y: -272, w: 66, d: 60, h: 92 },
  { x: -232, y: -205, w: 38, d: 38, h: 64 },
  { x: -64, y: -298, w: 44, d: 56, h: 84 },
  { x: -300, y: -60, w: 50, d: 44, h: 58 },
];
const hq: Block = { x: -150, y: -150, w: 74, d: 74, h: 214 };
// Selvion's quarter: the depot inside its geofence.
const depot: Block = { x: 262, y: -262, w: 104, d: 70, h: 34 };
const parked = [118, 148, 178].map((x) => ({ x, y: -262 }));
// The estate: a walled square with a gate on the avenue side.
const walls: Block[] = [
  { x: -205, y: 80, w: 250, d: 6, h: 12 },
  { x: -205, y: 330, w: 250, d: 6, h: 12 },
  { x: -330, y: 205, w: 6, d: 250, h: 12 },
  { x: -80, y: 132, w: 6, d: 104, h: 12 },
  { x: -80, y: 281, w: 6, d: 98, h: 12 },
];
const posts = [182, 230].map((y) => ({ x: -80, y }));
const houses: Block[] = [-290, -215, -140].flatMap((x, i) => [
  { x, y: 130, w: 52, d: 46, h: [30, 38, 26][i]! },
  { x, y: 250, w: 52, d: 46, h: [26, 32, 36][i]! },
]);
// The high street, facing the ring road. The second shop is the bakery.
const shops: Block[] = [
  { x: 104, y: 288, w: 52, d: 58, h: 46 },
  { x: 176, y: 288, w: 72, d: 58, h: 62 },
  { x: 248, y: 288, w: 52, d: 58, h: 42 },
  { x: 312, y: 288, w: 54, d: 58, h: 52 },
];
const blocksQ3: Block[] = [
  { x: 120, y: 120, w: 70, d: 60, h: 30 },
  { x: 262, y: 128, w: 80, d: 70, h: 40 },
];
/** Where each product's scene floats (ground point and height), in product order. */
const HOLO: Record<string, { x: number; y: number; z: number; scene: string }> = {
  selvion: { x: 210, y: -210, z: 150, scene: 'selvion' },
  'estate-entrance-security': { x: -205, y: 205, z: 128, scene: 'estate' },
  'websites-with-admin-panel': { x: 176, y: 288, z: 150, scene: 'websites' },
};
const scenes = prod.map((p) => HOLO[p.id]?.scene ?? '').join(' ');
---


<section id="hero" class="tour" data-theme="dark" data-tour data-scenes={scenes} aria-labelledby="hero-title" style={`--n:${prod.length};--len-products:${prod.length * 110}svh`}>
  <a href="#services" class="skip-tour btn btn-outline">Skip the product tour</a>
  <span id="products-tour" class="tour-mark" aria-hidden="true"></span>
  <div class="stage" data-stage>
    <div class="stage-bg" aria-hidden="true">
      <span class="bg-light"></span>
      <span class="bg-grid"></span>
      <span class="bg-glow" data-glow></span>
      <span class="bg-floor" data-floor></span>
      <canvas class="bg-dust" data-dust></canvas>
    </div>

    <!-- Screen one -->
    <div class="intro gutter" data-intro>
      <p class="pill" data-hero-kicker><span class="pill-dot" aria-hidden="true"></span>{h.eyebrow}</p>
      <h1 id="hero-title" class="hero-title" data-hero-title>
        {
          (h.lines ?? []).map((l, i) => (
            <span class="line-mask" data-line style={`--l:${i}`}>
              <span class="block">
                <Lit text={l.text} lit={l.lit} />
              </span>
            </span>
          ))
        }
      </h1>
      <p class="hero-lead" data-hero-intro>{h.lead}</p>
      <div class="hero-ctas" data-hero-ctas>
        <a href="#products-tour" class="btn btn-primary" data-magnetic>{h.ctas[0]!.label} <Icon name="arrow" /></a>
        <a href={h.ctas[1]!.href} class="btn btn-outline" data-magnetic>{h.ctas[1]!.label} <Icon name="calendar" /></a>
      </div>
      <dl class="intro-stats" data-hero-stats>
        {
          h.items.map((s) => (
            <div>
              <dt>{s.body}</dt>
              <dd>{s.title}</dd>
            </div>
          ))
        }
      </dl>
      <a href={SITE.whatsapp} class="cue" rel="noopener" data-journey-cue>
        <span class="cue-line" aria-hidden="true"><span></span></span>
        Or message us on WhatsApp
      </a>
    </div>

    <!-- The city: CSS 3D, a model of the places our software works in -->
    <div class="city-anchor" aria-hidden="true">
      <div class="city" data-city>
        <div class="city-world" data-city-world>
          <!-- The island the city stands on -->
          <div class="blk cb island" style={cb(0, 0, 1040, 1040, 18, -18)}>
            <b class="blk-top"><span class="island-grid"></span></b>
            <b class="blk-e"></b>
            <b class="blk-s"></b>
          </div>
          <span class="road ave-x"></span>
          <span class="road ave-y"></span>
          <span class="ring"><i></i></span>
          <span class="scan"></span>

          <!-- Selvion: the depot, its geofence, and Unit 07 -->
          <span class="fence"><i>Depot A</i></span>
          <span class="ping"></span>
          <div class="blk cb bld depot" style={cb(depot.x, depot.y, depot.w, depot.d, depot.h)}><b class="blk-top"></b><b class="blk-e"></b><b class="blk-s"></b></div>
          {
            parked.map((v) => (
              <div class="blk cb van" style={cb(v.x, v.y, 18, 32, 14)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }
          <div class="blk cb van unit07" style={cb(0, 0, 18, 32, 14)}><b class="blk-top"></b><b class="blk-e"></b><b class="blk-s"></b></div>

          <!-- The estate: walls, houses, the gate and a visitor -->
          {
            walls.map((b) => (
              <div class="blk cb wall" style={cb(b.x, b.y, b.w, b.d, b.h)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }
          {
            houses.map((b) => (
              <div class="blk cb bld house" style={cb(b.x, b.y, b.w, b.d, b.h)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }
          {
            posts.map((b) => (
              <div class="blk cb post" style={cb(b.x, b.y, 10, 10, 26)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }
          <span class="barrier"></span>
          <div class="blk cb car visitor" style={cb(0, 0, 16, 28, 11)}><b class="blk-top"></b><b class="blk-e"></b><b class="blk-s"></b></div>

          <!-- The high street; the second shop is the bakery -->
          {
            shops.map((b, i) => (
              <div class:list={['blk cb bld shop', i === 1 && 'bakery']} style={cb(b.x, b.y, b.w, b.d, b.h)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s">{i === 1 && <span class="sign">Example Bakery</span>}</b>
              </div>
            ))
          }
          {
            blocksQ3.map((b) => (
              <div class="blk cb bld" style={cb(b.x, b.y, b.w, b.d, b.h)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }

          <!-- Towers, and ours -->
          {
            towers.map((b, i) => (
              <div class:list={['blk cb bld tower', i % 2 && 'is-teal']} style={cb(b.x, b.y, b.w, b.d, b.h)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }
          <div class="blk cb bld tower hq" style={cb(hq.x, hq.y, hq.w, hq.d, hq.h)}>
            <b class="blk-top"><Image src={markPng} alt="" widths={[96, 192]} sizes="96px" class="hq-mark" loading="lazy" fetchpriority="low" /></b>
            <b class="blk-e"></b>
            <b class="blk-s"></b>
          </div>
          <span class="beacon"></span>

          <!-- Traffic on the ring road -->
          {
            [0, 1, 2, 3].map((i) => (
              <div class:list={['blk cb car ring-car', i % 2 && 'is-warm']} style={cb(0, 0, 14, 24, 10, 0, `--i:${i}`)}>
                <b class="blk-top" />
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            ))
          }

          <!-- Each product's scene: a beam of light up to its glass panel -->
          {
            prod.map((p, i) => {
              const at = HOLO[p.id];
              return at ? <span class="beam" style={`--x:${at.x}px;--y:${at.y}px;--hz:${at.z}px`} data-beam={i} /> : null;
            })
          }
        </div>
        <span class="city-dim" data-city-dim></span>
        <!-- The panels float in a flat layer above the city, placed over their districts by city.ts -->
        <div class="holo-layer">
        {
          prod.map((p, i) => {
            const at = HOLO[p.id];
            if (!at) return null;
            return (
              <div class:list={['holo', `holo-${at.scene}`]} data-holo={i} data-at={`${at.x},${at.y},${at.z}`}>
                <div class="holo-in">
                  {at.scene === 'selvion' && (
                    <>
                      <p class="holo-top">
                        <span class="holo-dot is-alert" />
                        Selvion
                        <span class="holo-tag">Demo data</span>
                      </p>
                      <p class="holo-big">Unit 07 left Depot A</p>
                      <p class="holo-meta">07:18 · Alert sent to your phone</p>
                      <span class="holo-bar">
                        <i />
                      </span>
                    </>
                  )}
                  {at.scene === 'estate' && (
                    <>
                      <p class="holo-top">
                        <span class="holo-dot is-gate" />
                        Gate 1 · Visitor code
                        <span class="holo-tag">Demo data</span>
                      </p>
                      <p class="holo-code">
                        {'482913'.split('').map((d) => (
                          <b>{d}</b>
                        ))}
                      </p>
                      <p class="holo-ok">Verified · House 12</p>
                    </>
                  )}
                  {at.scene === 'websites' && (
                    <>
                      <p class="holo-top">
                        <span class="holo-dot is-web" />
                        Example Bakery
                        <span class="holo-tag">Example site</span>
                      </p>
                      <p class="holo-label">Open today</p>
                      <p class="holo-hours">
                        <span class="old">8:00 to 18:00</span>
                        <span class="new">7:00 to 19:00</span>
                      </p>
                      <p class="holo-meta">Changed by your team, just now</p>
                    </>
                  )}
                </div>
              </div>
            );
          })
        }
        </div>
      </div>
    </div>

    <!-- The products: the words for what the city shows -->
    <div class="tour-notes" data-notes>
      <header class="tour-head">
        <p class="eyebrow">{tour.eyebrow}</p>
        <h2 class="tour-title"><Lit text={tour.heading} lit={tour.lit} /></h2>
        <div class="tour-progress" aria-hidden="true" data-progress-steps>{prod.map(() => <span><i /></span>)}</div>
      </header>
      <ol class="tour-list">
        {
          prod.map((p, i) => {
            const cta = ctaOf(p);
            const features = featuresOf(p)
              .filter((f) => f.confirmed)
              .slice(0, 4);
            return (
              <li class="tour-note card" data-note={i}>
                <p class="note-level">
                  <span class={`icon-tile is-sm tint-${p.data.accent}`}>
                    <Icon name={p.data.icon} />
                  </span>
                  <span class="note-num">
                    {String(i + 1).padStart(2, '0')}
                    <span class="note-of"> / {total}</span>
                  </span>
                  <span class="chip" data-status={p.data.status}>
                    {cta.chip}
                  </span>
                </p>
                <h3 class="note-title">{p.data.name}</h3>
                <p class="note-what">{p.data.descriptor.charAt(0).toUpperCase() + p.data.descriptor.slice(1)}</p>
                <p class="note-body">{p.data.summary}</p>
                {features.length > 0 && (
                  <ul class="ticks note-features">
                    {features.map((f) => (
                      <li>{f.title}</li>
                    ))}
                  </ul>
                )}
                <div class="note-ctas">
                  <a href={cta.href} class="btn btn-primary">
                    {cta.label}
                    <span class="sr-only">: {p.data.name}</span>
                  </a>
                  <a href={`/products/${p.id}/`} class="link-arrow">
                    Learn more<span class="sr-only"> about {p.data.name}</span> <Icon name="arrow" />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* ── The stage ──────────────────────────────────────────────────────── */
  .tour {
    /* How much scrolling each part takes (city.ts reads these). */
    --len-intro: 130svh;
    /* Set on the element from the number of products (city.ts reads it, so it must be a plain length). */
    --len-products: 330svh;
    --len-close: 110svh;
    --len: calc(var(--len-intro) + var(--len-products) + var(--len-close));
    position: relative;
    background: var(--color-night);
    color: var(--color-white);
  }
  /* For keyboard users: straight past the tour (visible on focus). */
  .skip-tour {
    position: absolute;
    left: 1rem;
    top: 6rem;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
  }
  .skip-tour:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .tour-mark {
    position: absolute;
    top: var(--len-intro);
    left: 0;
  }
  .stage {
    position: relative;
  }
  .stage-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* The night, a faint teal light from the top right; the amber glow follows the city. */
  .bg-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46% 54% at 84% 10%, color-mix(in srgb, var(--color-iris) 34%, transparent), transparent 72%),
      radial-gradient(50% 60% at 4% 96%, color-mix(in srgb, var(--color-teal-500) 14%, transparent), transparent 74%),
      linear-gradient(180deg, var(--color-night) 0%, color-mix(in srgb, var(--color-navy) 70%, var(--color-night)) 100%);
  }
  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-white) 4%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-white) 4%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    background-position: center;
    mask-image: radial-gradient(60% 70% at 62% 50%, #000 25%, transparent 80%);
  }
  /* The light that follows the city (city.ts moves both with transforms). */
  .bg-glow,
  .bg-floor {
    position: absolute;
    left: 75%;
    top: 50%;
  }
  .bg-glow {
    width: 64vmin;
    height: 56vmin;
    margin: -28vmin 0 0 -32vmin;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-gold) 20%, transparent), color-mix(in srgb, var(--color-gold) 6%, transparent) 55%, transparent);
  }
  .bg-floor {
    top: 72%;
    width: 64vmin;
    height: 18vmin;
    margin: -9vmin 0 0 -32vmin;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-teal-400) 30%, transparent), transparent);
  }
  .bg-dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Screen one ─────────────────────────────────────────────────────── */
  .intro {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: 100svh;
    max-width: 50rem;
    flex-direction: column;
    justify-content: center;
    padding-block: 7rem 4rem;
  }
  /*
   * Each line of the headline stays one line, and the type is sized so the
   * longer line ("Engineered for impact.", 9.4em in Urbanist) always fits.
   * So the line count can't change when the web font replaces the fallback:
   * no layout shift.
   */
  .hero-title {
    margin-top: 1.6rem;
    font-size: clamp(2.4rem, 4.4vw, 4.2rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero-title :global(.line-mask > span) {
    white-space: nowrap;
  }
  @media (max-width: 1023px) {
    .hero-title {
      font-size: min(3.4rem, calc((100vw - 2 * max(1rem, min(5vw, 4.5rem))) / 9.6));
    }
  }
  .hero-lead {
    margin-top: 1.6rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-grey-200);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
  .intro-stats {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .intro-stats > div {
    display: flex;
    min-width: 9rem;
    flex-direction: column-reverse;
    border-radius: 0.9rem;
    padding: 0.8rem 1.05rem 0.85rem;
    background: color-mix(in srgb, var(--color-iris) 9%, var(--color-night));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 26%, transparent),
      0 14px 30px -18px rgb(0 0 0 / 0.8);
  }
  .intro-stats dt {
    margin-top: 0.2rem;
    font-size: 0.84rem;
    color: var(--color-grey-200);
  }
  .intro-stats dd {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--color-white);
  }
  .cue {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    min-height: 44px;
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-grey-200);
    transition: color 0.4s var(--ease-expo);
  }
  .cue:hover {
    color: var(--color-white);
  }
  .cue-line {
    position: relative;
    width: 3.25rem;
    height: 1px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-white) 18%, transparent);
  }
  .cue-line > span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--color-iris-soft), transparent);
    animation: cue 2.4s var(--ease-expo) 1s 3;
    transform: translateX(-100%);
  }
  @keyframes cue {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }

  /*
   * ── The entrance (raleston-web's, in CSS) ────────────────────────────
   * It starts with the first paint, before any script. Desktop: the lines
   * rise out of their masks as their tracking settles. Phones: the headline
   * and the paragraph are shown as they paint (they're the largest things on
   * the first screen), and only the smaller pieces fade up. "backwards" fill,
   * so nothing holds a transform afterwards (the magnetic buttons need it).
   */
  @keyframes hero-rise {
    from {
      transform: translateY(108%) rotate(3deg);
      letter-spacing: 0.01em;
    }
  }
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(var(--from, 16px));
    }
  }
  @keyframes hero-up {
    from {
      transform: translateY(18px);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  :global(html.js:not(.reduced-motion)) .pill {
    animation: hero-fade-up 1s var(--ease-expo) 0.15s backwards;
    --from: 14px;
  }
  :global(html.js:not(.reduced-motion)) .hero-lead {
    animation: hero-up 1.1s var(--ease-expo) 0.45s backwards;
  }
  :global(html.js:not(.reduced-motion)) .hero-ctas > :global(*) {
    animation: hero-fade-up 1s var(--ease-expo) 0.6s backwards;
    --from: 18px;
  }
  :global(html.js:not(.reduced-motion)) .hero-ctas > :global(*:nth-child(2)) {
    animation-delay: 0.68s;
  }
  :global(html.js:not(.reduced-motion)) .intro-stats > div {
    animation: hero-fade-up 1s var(--ease-expo) 0.8s backwards;
  }
