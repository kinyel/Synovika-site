  /* Without the camera (no JavaScript, reduced motion), the light sits behind the city itself. */
  :global(html:is(.reduced-motion, :not(.js))) :is(.bg-glow, .bg-floor) {
    display: none;
  }
  :global(html:is(.reduced-motion, :not(.js))) .city-anchor {
    background:
      radial-gradient(40% 36% at 50% 42%, color-mix(in srgb, var(--color-gold) 9%, transparent), transparent 75%),
      radial-gradient(50% 30% at 50% 66%, color-mix(in srgb, var(--color-teal-400) 12%, transparent), transparent 75%);
  }
  .city {
    --k: 0.42;
    position: absolute;
    inset: 0;
