  /* ── Live: the camera, the traffic and each product's moment ── */
  :global(html.js:not(.reduced-motion)) .city-world {
    left: 50%;
    top: 50%;
  }
  :global(html.js:not(.reduced-motion)) .holo {
    display: block;
  }
  :global(html.js:not(.reduced-motion)) .holo.is-on .holo-in {
    opacity: 1;
    scale: 1;
    transition-delay: 0.35s;
  }
  :global(html.js:not(.reduced-motion)) .beam.is-on {
    opacity: 1;
  }
  :global(html.js:not(.reduced-motion)) .scan {
    animation: city-scan 9s linear infinite;
  }
  @keyframes city-scan {
    0% {
      translate: 0 0;
      opacity: 0;
    }
    8%,
    88% {
      opacity: 1;
    }
    100% {
      translate: 1040px 0;
      opacity: 0;
    }
  }
  :global(html.js:not(.reduced-motion)) .ring-car {
    animation: ring-drive 34s linear infinite;
    animation-delay: calc(var(--i) * -8.5s);
  }
  @keyframes ring-drive {
    0% {
      translate: -400px -400px 0;
      rotate: 90deg;
    }
    24.99% {
      rotate: 90deg;
    }
    25% {
      translate: 400px -400px 0;
      rotate: 0deg;
    }
    49.99% {
      rotate: 0deg;
    }
    50% {
      translate: 400px 400px 0;
      rotate: 90deg;
    }
    74.99% {
      rotate: 90deg;
    }
    75% {
      translate: -400px 400px 0;
      rotate: 0deg;
    }
    100% {
      translate: -400px -400px 0;
      rotate: 0deg;
    }
  }
  /* Off screen, the city holds still. */
  :global(.tour.is-paused) .city :global(*) {
    animation-play-state: paused !important;
  }
  /* Selvion: Unit 07 leaves the depot; as it crosses the fence, the alert goes out. */
  :global(html.js:not(.reduced-motion)) .unit07 {
    transition: translate 2.4s cubic-bezier(0.5, 0, 0.3, 1) 0.3s;
  }
  :global(html.js:not(.reduced-motion) .tour[data-scene='selvion']) .unit07 {
    translate: 150px -8px 0;
  }
  :global(html.js:not(.reduced-motion) .tour[data-scene='selvion']) .fence {
    border-color: var(--color-wine-300);
    background-color: color-mix(in srgb, var(--color-wine-500) 9%, transparent);
    box-shadow: inset 0 0 40px color-mix(in srgb, var(--color-wine-500) 24%, transparent);
    transition-delay: 1.5s;
  }
  :global(html.js:not(.reduced-motion) .tour[data-scene='selvion']) .ping {
    animation: city-ping 1.6s ease-out 1.5s 2;
  }
  @keyframes city-ping {
    from {
      scale: 0.3;
      opacity: 1;
    }
    to {
      scale: 3.4;
      opacity: 0;
    }
  }
  :global(html.js:not(.reduced-motion) .tour[data-scene='selvion']) .holo-bar > i {
    transform: none;
    transition: transform 1.6s var(--ease-expo) 1.4s;
