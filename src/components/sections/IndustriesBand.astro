---
/**
 * The band under the services (where the reference image has a wall of
 * client logos). Synovika has no client logos to show yet, so the band names
 * the sectors we build for instead, as two rows of chips that drift in
 * opposite directions with the scroll and lean with its speed
 * (src/scripts/scroll.ts). Every chip links to its industry page.
 */
import Icon from '../ui/Icon.astro';
import { industries } from '../../lib/content';

const ind = await industries();
const rows = [ind, [...ind].reverse()];
---

<section class="band" data-theme="dark" aria-labelledby="band-title" data-band>
  <h2 id="band-title" class="band-title gutter">The sectors we build for</h2>
  <div class="band-rows">
    {
      rows.map((row, r) => (
        <div class="band-row" data-band-row={r} aria-hidden={r === 1 ? 'true' : undefined}>
          {[0, 1].map((copy) => (
            <ul class="band-set" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((i) => (
                <li>
                  <a href={`/industries/${i.id}/`} class="band-chip" tabindex={r === 1 || copy === 1 ? -1 : undefined}>
                    <Icon name={i.data.icon} />
                    {i.data.name}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-block: 1px solid color-mix(in srgb, var(--color-white) 7%, transparent);
    background:
      radial-gradient(40% 120% at 50% 100%, color-mix(in srgb, var(--color-iris) 7%, transparent), transparent 70%),
      var(--color-night);
  }
  .band-title {
    margin-bottom: 1.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-grey-400);
  }
  .band-rows {
    display: grid;
    gap: 0.9rem;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .band-row {
    display: flex;
    width: max-content;
    gap: 0.9rem;
    will-change: transform;
  }
  .band-row[data-band-row='1'] {
    margin-left: -18rem;
  }
  .band-set {
    display: flex;
    gap: 0.9rem;
  }
  .band-chip {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.65rem;
    border-radius: 999px;
    padding: 0.55rem 1.15rem 0.55rem 0.9rem;
    white-space: nowrap;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    font-weight: 600;
    color: var(--color-grey-200);
    background: color-mix(in srgb, var(--color-white) 3%, var(--color-night));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-white) 9%, transparent);
    transition:
      color 0.3s,
      box-shadow 0.3s;
  }
  .band-chip :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-iris-soft);
  }
  .band-chip:hover {
    color: var(--color-white);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 45%, transparent);
  }
  .band-row[data-band-row='1'] .band-chip :global(svg) {
    color: var(--color-gold);
  }
</style>
