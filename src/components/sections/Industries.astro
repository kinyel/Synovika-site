---
/**
 * 10 · Industries (raleston-web's ring). Six square glass panels stand in a
 * ring on one platform and turn as the page scrolls, bringing each sector to
 * the front in turn. The Synovika mark sits at the centre: one way of
 * working under every sector. Beside it, a link to each industry's page.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import Lit from '../ui/Lit.astro';
import markPng from '../../assets/brand/mark.png';
import { home, industries } from '../../lib/content';

const head = (await home()).industries!;
const INDUSTRIES = (await industries()).map((i) => ({ id: i.id, name: i.data.name, short: i.data.short ?? i.data.name, line: i.data.note, icon: i.data.icon }));
const step = 360 / INDUSTRIES.length;
---

<section id="industries" class="section industries" data-theme="dark" aria-labelledby="industries-title">
  <div class="gutter ind-grid">
    <div class="ind-head">
      <p class="eyebrow">{head.eyebrow}</p>
      <h2 id="industries-title" class="h2 mt-4" data-reveal><Lit text={head.heading} lit={head.lit} /></h2>
      <p class="lead mt-4 max-w-[28rem]" data-reveal>{head.lead}</p>
    </div>

    <div class="s3d ind-scene" data-s3d data-s3d-start="top bottom" data-s3d-end="bottom top" aria-hidden="true">
      <div class="ind-world">
        <div class="ind-floor"><span>One way of working</span></div>
        <div class="ind-core"><i></i><i></i><i></i><b><Image src={markPng} alt="" width={96} /></b></div>
        {
          INDUSTRIES.map((ind, i) => (
            <div class="ind-panel" style={`--i:${i};--a:${i * step}deg`}>
              <div class="ind-front">
                <Icon name={ind.icon} />
                <b>{ind.short}</b>
                <span>{ind.line}</span>
              </div>
              <div class="ind-back" />
            </div>
          ))
        }
      </div>
    </div>

    <div class="ind-copy">
      <ul class="ind-chips">
        {
          INDUSTRIES.map((ind) => (
            <li data-reveal>
              <a href={`/industries/${ind.id}/`} class="ind-chip">
                <span class="icon-tile is-sm">
                  <Icon name={ind.icon} />
                </span>
                <span class="min-w-0 flex-1">
                  <b>{ind.name}</b>
                  <span class="ind-line">{ind.line}</span>
                </span>
                <Icon name="arrow" class="ind-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/industries/" class="link-arrow mt-6" data-reveal>All industries <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .industries {
    overflow: hidden;
    background:
      radial-gradient(45% 40% at 10% 20%, color-mix(in srgb, var(--color-iris) 8%, transparent), transparent 70%),
      radial-gradient(40% 40% at 80% 55%, color-mix(in srgb, var(--color-iris) 7%, transparent), transparent 70%),
      var(--color-night);
  }
  .ind-grid {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ind-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-areas: 'head scene' 'chips scene';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
    }
    .ind-head {
      grid-area: head;
      align-self: end;
    }
    .ind-scene {
      grid-area: scene;
    }
    .ind-copy {
      grid-area: chips;
      align-self: start;
    }
  }

  /* ── The ring ── */
  .ind-scene {
    --r: 250px;
    --pw: 190px;
    height: 400px;
    perspective: 1300px;
    perspective-origin: 50% 20%;
  }
  @media (max-width: 639px) {
    .ind-scene {
      --r: 150px;
      --pw: 128px;
      height: 300px;
    }
  }
  @media (min-width: 1280px) {
    .ind-scene {
      height: 520px;
    }
  }
  .ind-world {
    position: absolute;
    left: 50%;
    top: 46%;
    transform-style: preserve-3d;
    transform: rotateX(calc(-10deg + var(--ty))) rotateY(calc(var(--p) * -300deg + 18deg + var(--tx)));
  }
  .ind-world * {
    transform-style: preserve-3d;
  }
  /* The platform the panels stand on. */
  .ind-floor {
    position: absolute;
    left: calc(var(--r) * -1.45);
    top: calc(var(--r) * -1.45);
    width: calc(var(--r) * 2.9);
    height: calc(var(--r) * 2.9);
    transform: translateY(calc(var(--pw) / 2 + 2px)) rotateX(90deg);
    background:
      repeating-radial-gradient(120% 60% at 78% 8%, var(--lines) 0 1px, transparent 1px 26px),
      radial-gradient(closest-side, color-mix(in srgb, var(--color-iris) 18%, transparent), color-mix(in srgb, var(--color-navy) 40%, transparent) 70%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 22%, transparent);
  }
  .ind-floor span {
    position: absolute;
    right: 18px;
    bottom: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-iris-soft) 70%, transparent);
  }
  /* The CMDB at the centre: a small gold-rimmed cube. */
  .ind-core {
    --c: 64px;
    position: absolute;
    left: calc(var(--c) / -2);
    top: calc(var(--pw) / 2 - var(--c));
    width: var(--c);
    height: var(--c);
    transform: rotateY(calc(var(--p) * 300deg - 18deg));
  }
  .ind-core > i,
  .ind-core > b {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1.5px solid color-mix(in srgb, var(--color-spark) 80%, transparent);
    background: color-mix(in srgb, var(--color-spark) 10%, color-mix(in srgb, var(--color-night) 70%, transparent));
    box-shadow: 0 0 30px color-mix(in srgb, var(--color-spark) 30%, transparent);
  }
  .ind-core > i:nth-child(1) {
    transform: rotateY(90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > i:nth-child(2) {
    transform: rotateY(-90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > i:nth-child(3) {
    transform: rotateX(90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > b {
    transform: translateZ(calc(var(--c) / 2));
  }
  .ind-core :global(img) {
    width: 62%;
    height: auto;
  }
  /* A sector panel, standing on the ring. Brighter as it turns to the front. */
  .ind-panel {
    --face: cos(calc(var(--a) - var(--p) * 300deg + 18deg));
    position: absolute;
    left: calc(var(--pw) / -2);
    top: calc(var(--pw) / -2);
    width: var(--pw);
    height: var(--pw);
    transform: rotateY(var(--a)) translateZ(var(--r));
  }
  .ind-front,
  .ind-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 6px;
  }
  .ind-front {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: calc(var(--pw) * 0.09);
    background:
      radial-gradient(80% 70% at 30% 0%, color-mix(in srgb, var(--color-iris) calc(max(var(--face), 0) * 40%), transparent), transparent 75%),
      linear-gradient(150deg, color-mix(in srgb, var(--color-white) 14%, transparent), color-mix(in srgb, var(--color-white) 3%, transparent) 60%),
      color-mix(in srgb, var(--color-navy) 75%, var(--color-night));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) calc(25% + max(var(--face), 0) * 55%), transparent),
      0 0 calc(max(var(--face), 0) * 40px) color-mix(in srgb, var(--color-iris) 45%, transparent);
  }
  /* Panels dim as they turn away. A veil, not opacity: opacity on a 3D face makes
     Chrome sort it wrongly, and the centre cube would show through the front panel. */
  .ind-front::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-night);
    opacity: calc(0.65 - max(var(--face), 0) * 0.65);
    pointer-events: none;
  }
  .ind-front :global(svg) {
    width: calc(var(--pw) * 0.2);
    height: calc(var(--pw) * 0.2);
    margin-bottom: auto;
    color: var(--color-iris-soft);
  }
  .ind-front b {
    font-size: calc(var(--pw) * 0.095);
    line-height: 1.1;
    color: var(--color-white);
  }
  .ind-front span {
    font-size: calc(var(--pw) * 0.072);
    line-height: 1.3;
    color: var(--color-grey-200);
  }
  .ind-back {
    transform: rotateY(180deg);
    background: color-mix(in srgb, var(--color-indigo) 50%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 18%, transparent);
  }

  /* ── The list ── */
  .ind-chips {
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 560px) and (max-width: 1023px) {
    .ind-chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ind-chip {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.9rem;
    border-radius: 0.9rem;
    padding: 0.35rem 0.5rem 0.35rem 0.35rem;
    transition: background-color 0.3s;
  }
  .ind-chip:hover {
    background: color-mix(in srgb, var(--color-white) 4%, transparent);
  }
  .ind-chip :global(.ind-arrow) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--color-iris-soft);
    transition: transform 0.4s var(--ease-expo);
  }
  .ind-chip:hover :global(.ind-arrow) {
    transform: translateX(4px);
  }
  .ind-chips b {
    display: block;
    font-size: 1.08rem;
    color: var(--color-white);
  }
  .ind-line {
    display: block;
    font-size: 0.95rem;
    color: var(--color-grey-400);
  }
</style>
