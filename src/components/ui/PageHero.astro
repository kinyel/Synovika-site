---
/**
 * Inner-page header (raleston-web's): breadcrumbs, eyebrow, the page's one
 * H1, a lead, and a small 3D plate stack with the page's icon. The lead
 * carries data-speakable: it is the page's answer in a sentence.
 */
import type { Crumb } from '../../layouts/Base.astro';
import type { IconName } from './icons';
import PlateStack from '../scenes/PlateStack.astro';
import Lit from './Lit.astro';

interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  /** Words of the title lit in teal. */
  lit?: string;
  lead?: string;
  /** Icon on the lit plate of the 3D stack; false for no stack. */
  icon?: IconName | false;
  /** A smaller title, for long ones (articles). */
  compact?: boolean;
}
const { crumbs, eyebrow, title, lit, lead, icon = 'build', compact = false } = Astro.props;
---

<header class="page-hero" data-theme="dark">
  <div class="page-hero-glow" aria-hidden="true"></div>
  {icon && <PlateStack icon={icon} />}
  <div class="gutter relative page-hero-copy">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        {
          crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? (
                <span aria-current="page">{c.name}</span>
              ) : (
                <a href={c.href}>{c.name}</a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow mt-8">{eyebrow}</p>}
    <h1 class:list={['h1 page-title', compact && 'is-compact']} data-hero-title>
      <Lit text={title} lit={lit} />
    </h1>
    {lead && <p class="lead page-lead" data-speakable>{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(8rem, 16vw, 11rem) clamp(3rem, 6vw, 5rem);
    color: var(--color-white);
    background: var(--color-night);
  }
  /* The same lines as the home page's hero: fine, flat rings from the top right, and a soft glow at the bottom left. */
  .page-hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(68% 85% at 12% 100%, color-mix(in srgb, var(--color-iris) 18%, transparent) 0%, transparent 60%),
      repeating-radial-gradient(120% 60% at 78% 8%, var(--lines) 0 1px, transparent 1px 34px);
    pointer-events: none;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.9rem;
    color: var(--color-grey-400);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--color-grey-400);
  }
  .crumbs a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-grey-200);
  }
  .crumbs a:hover {
    color: var(--color-white);
  }
  .crumbs [aria-current] {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-iris-soft);
  }
  .page-title {
    margin-top: 1rem;
    max-width: 20ch;
  }
  .page-title.is-compact {
    max-width: 24ch;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    line-height: 1.08;
  }
  /* Leave room on the right for the plate stack. */
  @media (min-width: 768px) {
    .page-hero-copy > :global(*) {
      max-width: min(44rem, calc(100% - 22rem));
    }
  }
  @media (min-width: 1280px) {
    .page-hero-copy > :global(*) {
      max-width: min(46rem, calc(100% - 30rem));
    }
  }
  .page-lead {
    margin-top: 1.5rem;
    max-width: 44rem;
  }
</style>
