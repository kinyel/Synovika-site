---
/** Questions as native <details>, so they work without JavaScript. Unconfirmed answers are marked in drafts. */
import ToConfirm from './ToConfirm.astro';
interface Props {
  items: { q: string; a: string; confirmed: boolean }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details class="faq-item">
        <summary>
          <span>{f.q}</span>
          <ToConfirm when={!f.confirmed} />
        </summary>
        <p class="t-body">{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-line);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding-block: 1rem;
    font-size: var(--text-lead);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-ink-muted);
    transition: rotate var(--dur-3) var(--ease-out);
  }
  .faq-item[open] summary::after {
    rotate: 45deg;
  }
  .faq-item p {
    padding-bottom: 1.5rem;
    color: var(--color-ink-muted);
  }
</style>
