---
/** Questions as native <details>, so they work without JavaScript. Unconfirmed answers are marked in drafts. */
import ToConfirm from './ToConfirm.astro';
interface Props {
  items: { q: string; a: string; confirmed: boolean }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details class="faq-item glass">
        <summary>
          <span>{f.q}</span>
          <ToConfirm when={!f.confirmed} />
        </summary>
        <p class="t-body">{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.6rem;
    margin-top: 2.5rem;
    max-width: 52rem;
  }
  .faq-item {
    border-radius: var(--radius-md);
    transition: box-shadow var(--dur-3) var(--ease-out);
  }
  .faq-item[open] {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-teal-300) 30%, transparent),
      0 20px 50px -30px color-mix(in srgb, var(--color-teal-500) 45%, transparent);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 1rem 1.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-left: auto;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-live-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-teal-300) 30%, transparent);
    transition: rotate var(--dur-3) var(--ease-out);
  }
  .faq-item[open] summary::after {
    rotate: 45deg;
  }
  .faq-item p {
    padding: 0 1.25rem 1.4rem;
    color: var(--color-ink-soft);
  }
</style>
