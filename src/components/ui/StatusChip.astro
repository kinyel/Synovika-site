---
/** A product's status chip: amber while it's in development, teal once it's in pilot or live. */
import { STATUS, type Status } from '../../data/status';
interface Props {
  status: Status;
  class?: string;
}
const { status, class: className } = Astro.props;
---

<span class:list={['chip', className]} data-status={status}>{STATUS[status].chip}</span>
