---
/** A product's status: a teal signal when it's live or in pilot, a grey one while in development. */
import { STATUS, type Status } from '../../data/status';
interface Props {
  status: Status;
  class?: string;
}
const { status, class: className } = Astro.props;
---

<span class:list={['chip', className]}><span class="signal" data-state={status === 'in-development' ? 'idle' : undefined} aria-hidden="true"></span>{STATUS[status].chip}</span>
