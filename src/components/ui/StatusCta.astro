---
/** A product's status button and the line under it (D-032): "Join the waitlist" while it's in development. */
import StatusChip from './StatusChip.astro';
import Icon from './Icon.astro';
import { ctaOf, type Product } from '../../lib/content';
interface Props {
  product: Product;
  chip?: boolean;
}
const { product, chip = true } = Astro.props;
const cta = ctaOf(product);
---

<div class="status-cta">
  {chip && <StatusChip status={product.data.status} />}
  <div class="status-row">
    <a class="btn btn-primary" href={cta.href} data-magnetic>{cta.label}<span class="sr-only">: {product.data.name}</span> <Icon name="arrow" /></a>
    <a class="btn btn-outline" href="/contact/?topic=call">Book a call <Icon name="calendar" /></a>
  </div>
  <p class="status-note">{cta.note}</p>
</div>

<style>
  .status-cta {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .status-note {
    font-size: 0.95rem;
    color: var(--color-grey-200);
  }
</style>
