---
/**
 * A line icon from icons.ts, drawn from the shared sprite (/icons.svg, built
 * from the same file). The sprite's address carries a hash of the icon set,
 * so a changed icon is never served from an old cache. Decorative unless
 * given a label.
 */
import { createHash } from 'node:crypto';
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  /** Visible label for screen readers; omit for decorative icons. */
  label?: string;
}
const { name, class: className, label } = Astro.props;
const version = createHash('sha1').update(JSON.stringify(ICONS)).digest('hex').slice(0, 8);
---

<svg
  viewBox="0 0 24 24"
  class:list={['icon', className]}
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"><use href={`/icons.svg?v=${version}#${name}`}></use></svg
>
