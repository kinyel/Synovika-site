---
/** A page whose copy lives in src/content/pages/<id>.md: title, lead, SEO and body. */
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import type { Crumb } from '../../layouts/Base.astro';

interface Props {
  id: string;
  crumbs?: Crumb[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  noindex?: boolean;
}
const { id, crumbs, pageType, noindex } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`src/content/pages/${id}.md is missing`);
const { Content } = await render(entry);
const d = entry.data;
---

<Page title={d.seo.title} description={d.seo.description} heading={d.title} lead={d.lead} crumbs={crumbs} pageType={pageType} noindex={noindex}>
  {d.legalDraft && <p slot="hero" class="legal-draft">Draft: to be reviewed by a lawyer.</p>}
  <slot name="hero" slot="hero" />
  <section class="section" data-theme="paper">
    <div class="wrap">
      <div class="prose"><Content /></div>
      <slot />
    </div>
  </section>
</Page>

<style>
  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .legal-draft {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-wine-800);
    color: var(--color-white);
    font-weight: 600;
  }
</style>
