---
/** A page whose copy lives in src/content/pages/<id>.md: title, lead, SEO and body. */
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import type { Crumb } from '../../layouts/Base.astro';
import type { IconName } from '../ui/icons';

interface Props {
  id: string;
  crumbs?: Crumb[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  icon?: IconName | false;
  noindex?: boolean;
  cta?: boolean;
}
const { id, crumbs, pageType, icon, noindex, cta } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`src/content/pages/${id}.md is missing`);
const { Content } = await render(entry);
const d = entry.data;
const hasBody = (entry.body ?? '').trim().length > 0;
---

<Page title={d.seo.title} description={d.seo.description} heading={d.title} lead={d.lead} crumbs={crumbs} pageType={pageType} icon={icon} noindex={noindex} cta={cta}>
  {/* Off at Hero's request (D-067). To bring the notice back, restore this line:
  {d.legalDraft && <p slot="hero" class="legal-draft">Draft: to be reviewed by a lawyer.</p>}
  */}
  <slot name="hero" slot="hero" />
  <section class="section content-page" data-theme="paper">
    <div class="gutter">
      {
        hasBody && (
          <div class="prose">
            <Content />
          </div>
        )
      }
      <slot />
    </div>
  </section>
</Page>

<style>
  .content-page {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--color-night);
  }
  .legal-draft {
    display: inline-block;
    margin-top: 2rem;
    border-radius: 0.8rem;
    padding: 0.6rem 0.9rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-wine-800);
  }
</style>
