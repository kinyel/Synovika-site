---
/**
 * Navigation (raleston-web's dock, extended to the reference image's menus).
 * One floating glass dock: at the top of the page it is open and clear; once
 * the page scrolls it draws in to a narrower glass capsule with a thin line
 * along its foot that tracks how far down the page you are. Products,
 * Solutions, Industries, Company and Resources open one morphing flyout.
 * Behaviour lives in src/scripts/nav.ts.
 */
import { SITE } from '../../data/site';
import { STATUS } from '../../data/status';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import { industries, products, services } from '../../lib/content';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(prefix);
const prod = await products();
const svc = await services();
const ind = await industries();

interface Item {
  href: string;
  title: string;
  body: string;
  icon: IconName;
  tint?: string;
  chip?: string;
}
interface Group {
  id: string;
  label: string;
  base: string;
  columns: { title: string; items: Item[] }[];
  all?: { label: string; href: string };
}
const BUILD = ['software-development', 'requirements-engineering', 'system-architecture'];
const svcItem = (s: (typeof svc)[number]): Item => ({ href: `/services/${s.id}/`, title: s.data.name, body: s.data.blurb, icon: s.data.icon });
const groups: Group[] = [
  {
    id: 'products',
    label: 'Products',
    base: '/products/',
    columns: [{ title: 'Our products', items: prod.map((p) => ({ href: `/products/${p.id}/`, title: p.data.name, body: p.data.descriptor.charAt(0).toUpperCase() + p.data.descriptor.slice(1), icon: p.data.icon, tint: p.data.accent, chip: STATUS[p.data.status].chip })) }],
    all: { label: 'All products', href: '/products/' },
  },
  {
    id: 'solutions',
    label: 'Solutions',
    base: '/services/',
    columns: [
      { title: 'Build it right', items: svc.filter((s) => BUILD.includes(s.id)).map(svcItem) },
      { title: 'Keep it running', items: svc.filter((s) => !BUILD.includes(s.id)).map(svcItem) },
    ],
    all: { label: 'All services, and how we deliver them', href: '/services/' },
  },
  {
    id: 'industries',
    label: 'Industries',
    base: '/industries/',
    columns: [{ title: 'Who we build for', items: ind.map((i) => ({ href: `/industries/${i.id}/`, title: i.data.name, body: i.data.note, icon: i.data.icon })) }],
    all: { label: 'All industries', href: '/industries/' },
  },
  {
    id: 'company',
    label: 'Company',
    base: '/about/',
    columns: [
      {
        title: 'Synovika',
        items: [
          { href: '/about/', title: 'About us', body: 'Who we are and what "built around reality" means', icon: 'people' },
          { href: '/how-we-work/', title: 'How we work', body: 'Seven stages, from first call to support', icon: 'route' },
          { href: '/contact/', title: 'Contact', body: 'Start a project, or join a waitlist', icon: 'mail' },
        ],
      },
    ],
  },
  {
    id: 'resources',
    label: 'Resources',
    base: '/insights/',
    columns: [
      {
        title: 'Learn',
        items: [
          { href: '/insights/', title: 'Insights', body: 'Practical articles for people who run things', icon: 'book' },
          { href: '/faq/', title: 'FAQ', body: 'Straight answers to common questions', icon: 'chat' },
          { href: '/glossary/', title: 'Glossary', body: 'Software and tracking terms, in plain words', icon: 'search' },
        ],
      },
    ],
  },
];
const groupActive = (g: Group) => isActive(g.base) || (g.id === 'company' && (isActive('/how-we-work/') || isActive('/contact/'))) || (g.id === 'resources' && (isActive('/faq/') || isActive('/glossary/')));
---

<header class="nav fixed inset-x-0 top-0 z-50" data-nav>
  <a href="#main" class="nav-skip">Skip to content</a>
  <div class="nav-bar gutter">
    <div class="nav-dock">
      <a href="/" class="nav-brand col-start-1 flex w-fit shrink-0 items-center" aria-label="Synovika, home" data-nav-home>
        <Logo height={40} eager class="nav-logo" />
      </a>

      <nav aria-label="Main" class="nav-pill relative col-start-2 hidden items-center lg:flex" data-nav-pill>
        <span class="nav-hover" aria-hidden="true" data-nav-hover></span>
        {
          groups.map((g) => (
            <button type="button" class="nav-link" aria-expanded="false" aria-controls="nav-flyout" data-nav-trigger={g.id} data-active={groupActive(g) ? '' : undefined}>
              <span>{g.label}</span>
              <svg viewBox="0 0 10 6" class="nav-chev" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="nav-dot" aria-hidden="true" />
            </button>
          ))
        }
        <a href="/pricing/" class="nav-link" data-active={isActive('/pricing/') ? '' : undefined} aria-current={isActive('/pricing/') ? 'page' : undefined}>
          <span>Pricing</span>
          <span class="nav-dot" aria-hidden="true"></span>
        </a>

        <section id="nav-flyout" class="nav-flyout" aria-label="Menu" data-nav-flyout>
          <span class="nav-flyout-arrow" aria-hidden="true" data-nav-arrow></span>
          <div class="nav-flyout-clip" data-nav-clip>
            {
              groups.map((g) => (
                <div class="nav-pane" data-nav-pane={g.id} hidden>
                  <div class:list={['nav-cols', g.columns.length > 1 && 'is-two']}>
                    {g.columns.map((c) => (
                      <div>
                        <p class="nav-eyebrow">{c.title}</p>
                        <ul class="nav-grid">
                          {c.items.map((it, i) => (
                            <li style={`--i:${i}`}>
                              <a href={it.href} class="nav-item">
                                <span class:list={['nav-item-icon', it.tint && `tint-${it.tint}`]}>
                                  <Icon name={it.icon} />
                                </span>
                                <span>
                                  <span class="nav-item-title">
                                    {it.title}
                                    {it.chip && <span class="nav-item-chip">{it.chip}</span>}
                                  </span>
                                  <span class="nav-item-body">{it.body}</span>
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  {g.all && (
                    <a href={g.all.href} class="nav-all">
                      {g.all.label}
                      <Icon name="arrow" />
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </section>
      </nav>

      <div class="col-start-3 flex items-center justify-self-end gap-2">
        <a href="/contact/" class="nav-cta nav-cta-bar" aria-current={isActive('/contact/') ? 'page' : undefined} data-magnetic>
          <span class="nav-cta-fill" aria-hidden="true"></span>
          <span class="relative">Get started</span>
          <span class="nav-cta-chip" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <button type="button" class="nav-burger" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
          <span></span><span></span>
        </button>
      </div>
      <span class="nav-progress" aria-hidden="true"><i data-nav-progress></i></span>
    </div>
  </div>

  <div id="mobile-menu" class="nav-sheet" aria-hidden="true" inert data-menu>
    <div class="gutter flex min-h-full flex-col pt-28 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <nav aria-label="Menu">
        <ul class="flex flex-col">
          {
            groups.map((g) => (
              <li class="nav-sheet-row">
                <button type="button" class="nav-sheet-link" aria-expanded="false" data-sheet-toggle>
                  <span>{g.label}</span>
                  <span class="nav-sheet-plus" aria-hidden="true" />
                </button>
                <div class="nav-sheet-sub">
                  <div class="nav-sheet-cols">
                    <div>
                      <ul>
                        {g.columns
                          .flatMap((c) => c.items)
                          .map((it) => (
                            <li>
                              <a href={it.href}>{it.title}</a>
                            </li>
                          ))}
                        {g.all && (
                          <li>
                            <a href={g.all.href}>{g.all.label}</a>
                          </li>
                        )}
                      </ul>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
          <li class="nav-sheet-row">
            <a href="/pricing/" class="nav-sheet-link" aria-current={isActive('/pricing/') ? 'page' : undefined}>Pricing</a>
          </li>
        </ul>
      </nav>
      <div class="mt-auto pt-10">
        <a href="/contact/" class="nav-cta w-full justify-between">
          <span class="nav-cta-fill" aria-hidden="true"></span>
          <span class="relative">Get started</span>
          <span class="nav-cta-chip" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a href={SITE.whatsapp} class="nav-sheet-wa" rel="noopener"><Icon name="chat" /> WhatsApp {SITE.phone.display}</a>
        <p class="label nav-muted mt-4 flex flex-wrap gap-x-4 gap-y-1">
          <span>{SITE.email}</span>
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  /* The site is dark throughout, so the nav has one palette: white type, lit teal accents. */
  .nav {
    --n-fg: var(--color-white);
    --n-muted: color-mix(in srgb, var(--color-grey-200) 80%, transparent);
    --n-line: rgb(255 255 255 / 0.09);
    --n-hover: rgb(255 255 255 / 0.07);
    --n-accent: var(--color-iris-soft);
    --n-tint: color-mix(in srgb, var(--color-iris) 22%, transparent);
    --n-glass: rgb(3 21 20 / 0.74);
    --n-solid: rgb(4 24 23);
    --n-ease: var(--ease-expo);
    color: var(--n-fg);
  }
  .nav-muted {
    color: var(--n-muted);
  }
  .nav-bar {
    padding-top: max(0.85rem, env(safe-area-inset-top));
  }

  /* ── The dock ── */
  .nav-dock {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    margin-inline: auto;
    padding: 0.45rem 0.45rem 0.45rem 0.9rem;
    border-radius: 999px;
    background-color: rgb(3 21 20 / 0);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0),
      0 24px 60px -28px rgb(0 0 0 / 0);
    transition:
      max-width 0.9s var(--n-ease),
      background-color 0.6s var(--n-ease),
      box-shadow 0.6s var(--n-ease);
  }
  .nav[data-condensed] .nav-dock,
  :global(html:not(.js)) .nav-dock {
    max-width: 74rem;
    background-color: var(--n-glass);
    box-shadow:
      inset 0 0 0 1px var(--n-line),
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 24px 60px -28px rgb(0 0 0 / 0.85),
      0 0 60px -28px color-mix(in srgb, var(--color-iris) 70%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
  }
  .nav-brand {
    min-height: 44px;
    view-transition-name: site-logo;
  }
  .nav-brand :global(.nav-logo) {
    width: auto;
    height: 40px;
    transition: height 0.6s var(--n-ease);
  }
  .nav[data-condensed] .nav-brand :global(.nav-logo) {
    height: 36px;
  }
  .nav-progress {
    position: absolute;
    left: 1.6rem;
    right: 1.6rem;
    bottom: 0;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.6s var(--n-ease);
    pointer-events: none;
  }
  .nav[data-condensed] .nav-progress {
    opacity: 1;
  }
  :global(html[data-menu-open]) .nav[data-condensed] .nav-progress {
    opacity: 0;
  }
  .nav-progress i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--color-iris-soft) 35%, var(--color-gold));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ── Page links ── */
  .nav-pill {
    gap: 0.05rem;
  }
  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--n-muted);
    cursor: pointer;
    transition: color 0.35s var(--n-ease);
  }
  .nav-link:hover,
  .nav-link[aria-expanded='true'],
  .nav-link[data-active] {
    color: var(--n-fg);
  }
  .nav-chev {
    width: 9px;
    height: 6px;
    opacity: 0.6;
    transition:
      transform 0.45s var(--n-ease),
      opacity 0.3s;
  }
  .nav-link[aria-expanded='true'] .nav-chev {
    transform: rotate(180deg);
    opacity: 1;
    color: var(--n-accent);
  }
  .nav-dot {
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--n-accent);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--color-iris-soft) 80%, transparent);
    transform: scale(0);
    transition: transform 0.5s var(--n-ease);
  }
  .nav-link[data-active] .nav-dot {
    transform: scale(1);
  }
  .nav-hover {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--n-hover);
    opacity: 0;
    pointer-events: none;
  }

  /* ── The flyout ── */
  .nav-flyout {
    position: absolute;
    top: calc(100% + 1.1rem);
    left: 0;
    border-radius: 1.3rem;
    background:
      radial-gradient(110% 70% at 50% 0%, color-mix(in srgb, var(--color-iris) 24%, transparent), transparent 62%),
      var(--n-solid);
    box-shadow:
      inset 0 0 0 1px var(--n-line),
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      0 0 70px -30px color-mix(in srgb, var(--color-iris) 70%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.98);
    transform-origin: 50% 0;
    transition:
      opacity 0.35s var(--n-ease),
      transform 0.5s var(--n-ease);
  }
  .nav-flyout[data-open] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .nav-flyout-clip {
    overflow: hidden;
    border-radius: inherit;
  }
  .nav-flyout-arrow {
    position: absolute;
    top: -5px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-iris) 30%, var(--color-night));
    box-shadow: -1px -1px 0 0 var(--n-line);
    transform: rotate(45deg);
  }
  .nav-pane {
    width: max-content;
    padding: 1.35rem 1.4rem 1.25rem;
  }
  .nav-pane[hidden] {
    display: none;
  }
  .nav-cols {
    display: grid;
    grid-template-columns: 22rem;
    column-gap: 1.25rem;
  }
  .nav-cols.is-two {
    grid-template-columns: repeat(2, 20.5rem);
  }
  .nav-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--n-accent);
  }
  .nav-eyebrow::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--n-line), transparent);
  }
  .nav-grid {
    display: grid;
    gap: 0.1rem;
  }
  .nav-grid > li {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--n-ease),
      transform 0.5s var(--n-ease);
    transition-delay: calc(var(--i) * 30ms);
  }
  .nav-pane[data-shown] .nav-grid > li {
    opacity: 1;
    transform: none;
  }
  .nav-item {
    position: relative;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.55rem 0.7rem;
    border-radius: 0.85rem;
    transition: background-color 0.3s var(--n-ease);
  }
  .nav-item:hover,
  .nav-item:focus-visible {
    background: var(--n-hover);
  }
  .nav-item-icon {
    --tint: var(--color-iris);
    --tint-soft: var(--color-iris-soft);
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border-radius: 0.65rem;
    color: var(--tint-soft);
    background: color-mix(in srgb, var(--tint) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tint-soft) 24%, transparent);
    transition:
      color 0.3s,
      background-color 0.3s;
  }
  .nav-item:hover .nav-item-icon {
    color: var(--color-white);
    background: color-mix(in srgb, var(--tint) 70%, transparent);
  }
  .nav-item-icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .nav-item-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: 0.93rem;
    font-weight: 600;
  }
  .nav-item-chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-glow);
  }
  .nav-item-body {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--n-muted);
  }
  .nav-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    border-radius: 0.85rem;
    padding: 0.75rem 0.85rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--n-fg);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px var(--n-line);
    transition: background-color 0.3s var(--n-ease);
  }
  .nav-all:hover {
    background: var(--n-hover);
  }
  .nav-all :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--n-accent);
    transition: transform 0.4s var(--n-ease);
  }
  .nav-all:hover :global(svg) {
    transform: translateX(3px);
  }

  /* ── Call to action: the image's solid teal button ── */
  .nav-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.38rem 0.38rem 0.38rem 1.15rem;
    border-radius: 0.8rem;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-white);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-teal-600) 55%, var(--color-teal-700)), var(--color-teal-700));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 10px 30px -12px color-mix(in srgb, var(--color-teal-500) 65%, transparent);
    transition: box-shadow 0.45s var(--n-ease);
  }
  .nav-cta:hover {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      0 0 40px 0 color-mix(in srgb, var(--color-teal-500) 50%, transparent);
  }
  @media (max-width: 639px) {
    .nav-cta-bar {
      display: none;
    }
  }
  .nav-cta-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.3) 48%, transparent 66%);
    transform: translateX(-110%);
    transition: transform 0.9s var(--n-ease);
  }
  .nav-cta:hover .nav-cta-fill {
    transform: translateX(110%);
  }
  .nav-cta-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    color: var(--color-white);
    background: rgb(255 255 255 / 0.16);
    transition: transform 0.6s var(--n-ease);
  }
  .nav-cta-chip :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .nav-cta:hover .nav-cta-chip {
    transform: translateX(2px);
  }

  /* ── Menu button (below desktop) ── */
  .nav-burger {
    position: relative;
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--n-line);
    cursor: pointer;
  }
  @media (max-width: 1023px) {
    .nav-burger {
      display: grid;
    }
  }
  .nav-burger span {
    position: absolute;
    width: 1.05rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--n-fg);
    transition: transform 0.55s var(--n-ease);
  }
  .nav-burger span:first-child {
    transform: translateY(-3.5px);
  }
  .nav-burger span:last-child {
    transform: translateY(3.5px);
  }
  .nav-burger[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }
  .nav-burger[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }
  /* Without JavaScript the menu button can't open the sheet: the dock links to every overview instead. */
  :global(html:not(.js)) .nav-burger {
    display: none;
  }

  /* ── Menu sheet (below desktop) ── */
  .nav-sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow-y: auto;
    background:
      radial-gradient(80% 45% at 90% 0%, color-mix(in srgb, var(--color-iris) 26%, transparent), transparent 70%),
      radial-gradient(70% 40% at 0% 100%, color-mix(in srgb, var(--color-gold) 12%, transparent), transparent 70%),
      var(--color-night);
