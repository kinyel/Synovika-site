---
/**
 * The footer (brief section 7): every section of the site, how to reach us,
 * the area we serve, the BN number once Hero gives it, the motion setting,
 * and the tagline.
 */
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
import Todo from '../ui/Todo.astro';
import { products, services } from '../../lib/content';
import { SITE } from '../../data/site';
import { isTodo } from '../../lib/drafts';

const svc = await services();
const prod = await products();
const groups = [
  { title: 'Services', links: svc.map((s) => ({ label: s.data.name, href: `/services/${s.id}/` })) },
  { title: 'Products', links: prod.map((p) => ({ label: p.data.name, href: `/products/${p.id}/` })) },
  {
    title: 'Company',
    links: [
      { label: 'How we work', href: '/how-we-work/' },
      { label: 'About', href: '/about/' },
      { label: 'Insights', href: '/insights/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy notice', href: '/privacy/' },
      { label: 'Cookie notice', href: '/cookies/' },
      { label: 'Terms of use', href: '/terms/' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="ftr noise" data-theme="dark">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <a href="/" aria-label="Synovika, home" class="ftr-logo"><Logo height={56} register="dark" /></a>
        <p class="ftr-area t-muted">{SITE.areaServed.sentence}</p>
        <ul class="ftr-contact">
          <li><a href={`mailto:${SITE.email}`}><Icon name="mail" /><span>{SITE.email}</span></a></li>
          <li><a href={SITE.whatsapp} rel="noopener"><Icon name="chat" /><span>WhatsApp {SITE.phone.display}</span></a></li>
          <li><a href={`tel:${SITE.phone.tel}`}><Icon name="phone" /><span>Call {SITE.phone.display}</span></a></li>
        </ul>
      </div>
      <nav class="ftr-links" aria-label="Footer">
        {
          groups.map((g) => (
            <div>
              <h2 class="t-label t-muted">{g.title}</h2>
              <ul>
                {g.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="ftr-bottom">
      <p class="ftr-legal t-muted">
        © {year} {SITE.name}
        {isTodo(SITE.bn) ? <Todo need="CAC business name (BN) number" /> : <span>· {SITE.bn}</span>}
      </p>
      <div class="motion" role="group" aria-label="Motion" data-motion-setting>
        <span class="t-label t-muted">Motion</span>
        <button type="button" data-motion="full" aria-pressed="false">Full</button>
        <button type="button" data-motion="reduced" aria-pressed="false">Reduced</button>
      </div>
      <p class="ftr-tagline t-label">{SITE.tagline}</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(4rem, 8vw, 7rem) max(2rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }
  .ftr-top {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    .ftr-top {
      grid-template-columns: 4fr 8fr;
      gap: var(--grid-gap);
    }
  }
  .ftr-logo {
    display: inline-flex;
    border-radius: var(--radius-sm);
  }
  .ftr-area {
    margin-top: 1.5rem;
    max-width: 22rem;
  }
  .ftr-contact {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.25rem;
  }
  .ftr-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
  }
  .ftr-contact a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .ftr-contact :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-live-ink);
  }
  .ftr-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--grid-gap);
  }
  @media (min-width: 48rem) {
    .ftr-links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ftr-links h2 {
    margin-bottom: 0.75rem;
  }
  .ftr-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-ink);
    transition: color var(--dur-2) var(--ease-out);
  }
  .ftr-links a:hover {
    color: var(--color-live-ink);
  }
  .ftr-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
  }
  .ftr-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .motion {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .motion .t-label {
    margin-right: 0.5rem;
  }
  .motion button {
    min-height: 2.25rem;
    min-width: 44px;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    color: var(--color-ink-muted);
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .motion button[aria-pressed='true'] {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  /* The setting needs JavaScript to apply; without it the system setting rules. */
  :global(html:not(.js)) .motion {
    display: none;
  }
  .ftr-tagline {
    letter-spacing: var(--tracking-wide);
    color: var(--color-structure);
  }
</style>

<script>
  /** The motion setting: stored, then the page reloads so every scene starts in the right mode (D-023). */
  const KEY = 'synovika:motion';
  const html = document.documentElement;
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-motion]')) {
    b.setAttribute('aria-pressed', String(b.dataset.motion === html.dataset.motion));
    b.addEventListener('click', () => {
      if (b.dataset.motion === html.dataset.motion) return;
      try {
        localStorage.setItem(KEY, b.dataset.motion!);
        location.reload();
      } catch {
        /* Storage is blocked, so the choice can't be remembered: the system setting stays in charge. */
      }
    });
  }
</script>
