---
/**
 * Hero's own logo (D-044), never redrawn: brand/synovika-logo.png, cropped by
 * scripts/logo-assets.mjs and served as AVIF and WebP at the sizes asked for.
 * The compact crop leaves out the tagline line, which is unreadable at small
 * sizes; the full crop keeps it. Never smaller than 120 px wide (brief 4.1).
 */
import { Picture } from 'astro:assets';
import compact from '../../assets/brand/logo-compact.png';
import full from '../../assets/brand/logo.png';

interface Props {
  /** Height in CSS pixels. */
  height?: number;
  tagline?: boolean;
  /** Load at once (the header) or when near the screen. */
  eager?: boolean;
  class?: string;
}
const { height = 44, tagline = false, eager = false, class: className } = Astro.props;
const src = tagline ? full : compact;
const width = Math.round((height * src.width) / src.height);
---

<Picture
  src={src}
  alt=""
  width={width}
  height={height}
  widths={[width, Math.round(width * 2), Math.round(width * 3)].filter((w) => w <= src.width)}
  sizes={`${width}px`}
  formats={['avif', 'webp']}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['logo', className]}
/>
