---
/**
 * A product's screen on its own page: the same app the laptop shows on the
 * home page, in a glass frame, sized to its container (the app is laid out in
 * em, on 1/72 of the frame's width). Decorative, with demo data.
 */
import ScreenSelvion from './ScreenSelvion.astro';
import ScreenEstate from './ScreenEstate.astro';
import ScreenWebsites from './ScreenWebsites.astro';
import './screens.css';

interface Props {
  id: string;
  /** What the picture shows, for the caption. */
  caption: string;
}
const { id, caption } = Astro.props;
const S = { selvion: ScreenSelvion, 'estate-entrance-security': ScreenEstate, 'websites-with-admin-panel': ScreenWebsites }[id];
---

{
  S && (
    <figure class="pscreen" data-reveal>
      <div class="pscreen-frame" aria-hidden="true">
        <div class="pscreen-screen">
          <div class="pscreen-app">
            <S />
          </div>
        </div>
      </div>
      <figcaption class="pscreen-cap">{caption}</figcaption>
    </figure>
  )
}

<style>
  .pscreen {
    margin: 0;
  }
  .pscreen-frame {
    position: relative;
    border-radius: clamp(0.8rem, 1.6vw, 1.25rem);
    padding: clamp(0.4rem, 1vw, 0.75rem);
    background: linear-gradient(180deg, #0b1111, #050808);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 90px -40px rgb(0 0 0 / 0.9),
      0 0 80px -20px color-mix(in srgb, var(--color-iris) 35%, transparent);
  }
  .pscreen-screen {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: clamp(0.4rem, 0.8vw, 0.6rem);
    background: #050d0d;
  }
  /* The app's em: one 72nd of the screen's width (cqw needs the container above it). */
  .pscreen-app {
    position: absolute;
    inset: 0;
    font-size: calc(100cqw / 72);
  }
  .pscreen-cap {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--color-grey-400);
  }
</style>
