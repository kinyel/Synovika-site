---
/**
 * Websites with an Admin Panel on the laptop's screen (decorative): the
 * admin panel on the left, the live example site on the right. The example
 * business is made up.
 */
---

<div class="app app-web">
  <div class="app-side">
    <p class="app-brand"><span class="app-dot is-web"></span>Site admin</p>
    <ul>
      <li class="is-on">Home</li>
      <li>About</li>
      <li>Menu and prices</li>
      <li>Contact</li>
      <li class="is-add">+ Add page</li>
    </ul>
  </div>
  <div class="app-main">
    <div class="app-bar">
      <p class="app-title">Edit page · Home</p>
      <span class="app-publish">Publish</span>
      <span class="app-demo">Example site</span>
    </div>
    <div class="web-grid">
      <div class="web-editor">
        <p class="app-h">Headline</p>
        <p class="web-field">Fresh bread, baked every morning<i class="web-caret"></i></p>
        <p class="app-h">Text</p>
        <p class="web-field is-area">Open from 7am. Order by noon for same-day pick-up.</p>
        <p class="app-h">Opening hours</p>
        <p class="web-field">Mon to Sat, 7:00 to 19:00</p>
        <p class="web-saved"><i></i>Published 2 min ago</p>
      </div>
      <div class="web-preview">
        <div class="web-nav"><b>Example Bakery</b><span>Home</span><span>About</span><span>Menu</span><span>Contact</span></div>
        <div class="web-hero">
          <p class="web-h">Fresh bread, baked every morning</p>
          <p class="web-p">Open from 7am. Order by noon for same-day pick-up.</p>
          <span class="web-btn">Order now</span>
        </div>
        <div class="web-cards"><span></span><span></span><span></span></div>
      </div>
    </div>
  </div>
</div>
