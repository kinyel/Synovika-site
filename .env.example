# Build-time settings, read by Astro. Copy to .env for local builds.
# On Cloudflare Pages, set the same names under Settings > Environment variables.

# The site's address, with no trailing slash. Production: https://synovika.com
PUBLIC_SITE_URL=https://synovika.com

# true = draft build: drafts, TODO(hero) markers and unconfirmed features are shown,
# /lab is built, and every page is noindex. Use it for preview branches only.
PUBLIC_SHOW_DRAFTS=false

# Cloudflare Turnstile site key for the contact form (public).
# Local testing: 1x00000000000000000000AA always passes.
PUBLIC_TURNSTILE_SITE_KEY=
