{
  "name": "synovika-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:drafts": "PUBLIC_SHOW_DRAFTS=true astro build",
    "preview": "wrangler pages dev dist",
    "serve": "astro preview --port 4330",
    "check": "astro check && tsc --noEmit",
    "brand:icons": "node scripts/logo-assets.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "qa:contrast": "node scripts/contrast.mjs",
    "qa:pages": "node scripts/pages.mjs",
    "qa:widths": "node scripts/widths.mjs",
    "qa:tour": "node scripts/tour.mjs",
    "qa:a11y": "node scripts/a11y.mjs",
    "qa:lh": "node scripts/lh.mjs",
    "qa:jsonld": "node scripts/jsonld.mjs",
    "qa:links": "node scripts/links.mjs",
    "qa:html": "html-validate \"dist/**/*.html\"",
    "qa:nojs": "node scripts/nojs.mjs",
    "qa:motion": "node scripts/motion-parity.mjs",
    "qa:size": "node scripts/size.mjs",
    "qa:prod-guard": "node scripts/prod-guard.mjs",
    "qa:fps": "node scripts/pagefps.mjs",
    "qa:copy": "node scripts/copy-lint.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/urbanist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "nanostores": "1.5.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/urbanist": "5.3.0",
    "chrome-launcher": "1.2.2",
    "html-validate": "11.16.2",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "playwright": "1.64.0",
    "satori": "0.47.1",
    "schema-dts": "2.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
